// The shell frame: chrome, the keyboard, and the screens hung off it (#69).
//
// Light, one scheme throughout, no toggle (ADR-0011) — the palette below is the
// prototype's, which ADR-0011 calls a starting point rather than a mandate. There is no
// dark token set and no theme switch: **absent, not defaulted off.**
//
// Three rules from 04-screens.md §0 are structural here rather than per screen, which is
// the whole point of there being a frame:
//
//   * **Chrome does not vanish for any screen.** The header and the footer are outside the
//     screen slot, so no screen can remove them — including the ones that will show secret
//     material, where a disappearing frame would be a surprise on the screen demanding the
//     most attention.
//   * **Keyboard only, no pointer.** The software renderer draws no cursor and nothing here
//     has a `TouchArea`. One `FocusScope` in the frame owns every key, so navigation cannot
//     be reimplemented — or forgotten — screen by screen. Escape cancels wherever a cancel
//     exists, which the router decides by having somewhere to go back to.
//   * **The two breakpoints, and no third.** `wide` is computed once, from the logical
//     width the scale factor produced (04-screens.md §0, §11.2: the threshold is the design
//     width). The review panel is its first real consumer — a fixed rail beside the outputs
//     above it, stacked above them below it — and it reads this rather than deriving its own.
//
// The frame also **appends one row to every screen**: 04-screens.md §7 lists *restart /
// shut down* as always available, and a screen that had to add it itself is a screen that
// can forget it. It is the last row of the ring on every screen, reachable from all of them
// with the same two keys as everything else.

// What the user asked for. The frame names the intent; the router decides where it lands
// (04-screens.md: the shell decides nothing about money and branches on no validation
// outcome, and one callback carrying an intent is what keeps that checkable).
export enum Intent {
    create,
    create-continue,
    create-confirm,
    create-done,
    import,
    restore,
    // 04-screens.md §5's one confirm. Which of the two things it is — *continue without
    // passphrase* or *use this passphrase* — is stated by the label the user pressed, and is
    // not a second intent: the passphrase is a value the screen holds, and no value crosses
    // here (standing rule 4).
    load-confirm,
    // §7's hub, and the four actions it offers. Each is a screen a later slice brings; naming
    // them here rather than routing all four through one anonymous intent is what keeps *the
    // frame names the intent* true, even while they share a destination.
    watch-only,
    sign,
    verify-address,
    backup-export,
    // 04-screens.md §11.2's one action: the review panel's *sign*, which starts §11.3's walk
    // rather than producing a signature. And §11.3's own press, which advances the walk. Two
    // names for two presses, because the frame names what the user asked for — and neither
    // carries a position: the walk's place is `review`'s state, not a value crossing here.
    review-sign,
    address-confirm,
    // §11.4's gate, and it is the **only** intent in this enum a single press cannot fire: it
    // is dispatched by the hold clock below, once, when the hold completes. Refusing is
    // `cancel`, which is what every other cancel on this path already is — 02-core.md §7's
    // *discard, and nothing else*.
    sign-confirm,
    // §11.5's one "done", and §7's row that brings the same screen back. Two names because the
    // frame names what the user asked for, and these are two different asks that happen to draw
    // the same thing.
    outbound-done,
    redisplay,
    session-end,
    shut-down,
    restart,
    cancel,
}

// Which screen is in the slot. `unbuilt` is honest rather than permanent: the three start
// entries route somewhere real in later slices, and until then the frame says so instead of
// swallowing the press (standing rule 8).
export enum Screen {
    start,
    dice,
    words,
    retype,
    load,
    identity,
    scan,
    // 04-screens.md §11.2's panel, §11.3's per-address walk, and the discard-only screen
    // 02-core.md §7 ends a refusal on. All three are reached from a completed transaction
    // scan and from nowhere else.
    review,
    address,
    // §11.4's gate and §11.5's outbound animation. The gate is the last screen before a
    // signature exists and the animation is the first one after it.
    gate,
    outbound,
    refused,
    unbuilt,
    ending,
}

// One numbered word of the phrase. The *position* travels with the text rather than being
// the index of a row, because 04-screens.md §3's fill is column-major: the thirteenth word
// is the first row of the right-hand column, and a component that numbered its own rows
// would have to be told which column it is.
export struct Word {
    position: int,
    text: string,
}

// One slot of the retype (04-screens.md §4). `text` is what the *user* typed — the committed
// word, or the letters going into the slot they are on — and never the phrase: the answer is
// in core, behind no accessor at all. `ghost` is the rest of the single remaining word, drawn
// dim inline after the buffer, which is the one completion this component offers (02-core.md
// §4's fifth behaviour: it finishes the word being typed and proposes none).
export struct Slot {
    position: int,
    text: string,
    ghost: string,
    current: bool,
}

// One of the four accounts, as the identity screen states it (04-screens.md §7). Three
// columns because they are three different facts about one account and the eye reads them
// down: which BIP it is, the script type §7 names, and the path a coordinator will ask for.
export struct Account {
    family: string,
    script: string,
    path: string,
}

// One output row of the review panel (04-screens.md §11.2). Every field arrives already
// written: `amount` is `format::btc`'s digits, `groups` is `format::address_groups`'s own
// split, and `settled` is the re-derivation statement — which is present exactly when core
// said the byte-compare ran, because §11.2's *change is settled* may not be a sentence this
// file decides to draw.
export struct Output {
    index: string,
    label: string,
    settled: string,
    amount: string,
    groups: [string],
}

// The numbers the frame lays itself out with, in one place because one of them is an owed
// measurement (00-overview.md, 04-screens.md §3): *that two columns of 12 words fit the
// 800×600 minimum canvas at the settled type size*. The shell reads `words-required` and
// `words-chrome` off this global at startup and prints both against the canvas it learned,
// so the claim is checked on every boot rather than measured once in a browser frame.
export global Metrics {
    out property <length> header-height: 44px;
    out property <length> footer-height: 48px;
    out property <length> rule: 1px;
    // The screen slot's padding at each breakpoint (04-screens.md §0). The floor is the
    // narrow one, which is why that is the value the measurement below is taken against.
    out property <length> slot-padding: 24px;
    out property <length> slot-padding-wide: 44px;

    // The words screen, as the heights it is actually built from.
    out property <length> word-row: 26px;
    out property <length> words-banner: 52px;
    out property <length> words-gap: 14px;
    out property <length> words-continue: 48px;
    out property <length> words-required: root.words-banner + root.words-gap
        + 12 * root.word-row + root.words-gap + root.words-continue;
    // 04-screens.md §11.1's *modest size rather than full screen*, in the design canvas's own
    // pixels. It fits the floor with room over: at 800×600 the slot leaves 458 logical px of
    // height (the same number `words-required` is measured against), and the scanning screen
    // spends 34 on the heading, 240 here and about 90 on the progress and the note.
    out property <length> preview-width: 320px;
    out property <length> preview-height: 240px;

    // What the chrome costs the screen slot at the floor, which is the narrow breakpoint's
    // padding: the header, both rules, the footer and the slot's own padding top and bottom.
    // One property rather than one per screen, because it is a fact about the frame — the
    // words screen and the review panel are measured against the same number.
    out property <length> slot-chrome: root.header-height + 2 * root.rule + root.footer-height
        + 2 * root.slot-padding;

    // 04-screens.md §11.2, as the heights the panel is actually built from — the second owed
    // measurement this global exists for. The rail's numbers and the output rows are separate
    // properties because the bound is a *row count*: if the sum does not fit, §11.2 says the
    // row count drops, and it can only drop if the row is a number of its own.
    //
    // §0 fixes the address at 17–22 px logical. The panel takes the floor of that range and
    // §11.3's walk takes the top of it, which is the one place in this appliance where a
    // larger type is worth a wrapped line.
    out property <length> address-size: 17px;
    out property <length> walk-address-size: 22px;
    // A fact cell: the small label above the digits (§11.2.1 — the unit is a separate label,
    // dimmer and smaller, and the digits carry no unit of their own).
    out property <length> fact-label: 15px;
    out property <length> fact-value: 20px;
    out property <length> fact-cell: root.fact-label + root.fact-value;
    out property <length> facts-spacing: 5px;
    // The fee's three secondary readings on one line, and the advisory warning under them.
    // Both are the fee cell's continuation rather than rows of their own, which is what keeps
    // the warning **inline on the fee row** (§11.2) while the facts stay a two-row grid.
    //
    // `fee-note` is counted in the sum **whether or not the warning fires**: a transaction that
    // trips it has to fit the same panel as one that does not, and a measurement taken without
    // it would be a measurement of the easy case.
    out property <length> fee-detail: 19px;
    out property <length> fee-note: 17px;
    out property <length> facts-stacked: 2 * root.fact-cell + root.facts-spacing
        + root.fee-detail + root.fee-note;
    out property <length> outputs-header: 15px;
    out property <length> review-spacing: 6px;
    // One output row: the label line — index, what the output is, and the amount — above the
    // address at full width. A **minimum** rather than a fixed height, because an address that
    // wraps must grow the row instead of being clipped (§0: never truncated). The measurement
    // below is what asserts it does not have to at the floor.
    out property <length> output-label: 18px;
    out property <length> output-row: root.output-label + 1.3 * root.address-size + 3px;
    // §11.2's bound, and 02-core.md §7 refuses a seventh before this screen exists.
    out property <int> output-bound: 6;
    // §11.2's one control, which the sum has to carry: a panel measured without the row that
    // starts §11.3's walk is a panel measured without the thing it is for.
    out property <length> review-action: 44px;
    out property <length> review-required: root.facts-stacked + root.review-spacing
        + root.outputs-header + root.review-spacing
        + root.output-bound * root.output-row + root.review-spacing + root.review-action;
    // The rail in the wide state (§11.2: *a fixed left rail*). Fixed, so the address column's
    // width is a number rather than whatever is left over after the longest amount.
    out property <length> rail-width: 300px;
    out property <length> rail-gap: 24px;

    // §11.4's gate. **The hold, as a duration and a tick**, and the two are one decision: the
    // clock advances by `hold-tick` while a key is down and the hold completes at
    // `hold-duration`, so the tick is what the bar moves by and nothing else reads it.
    //
    // Three seconds is the prototype's number (`docs/prototypes/transaction-review.html` — *Hold
    // to sign 3s*), which §0 calls a starting point rather than a mandate. 50 ms is four ticks
    // per frame at 4 fps: fine enough that the bar reads as continuous and coarse enough that it
    // costs nothing on the software renderer.
    //
    // **Neither is a function of anything about the transaction** (§11.4): the gate is
    // byte-identical with and without the warning, so a hold that lengthened when the warning
    // fired would convert an advisory into a soft block and teach that duration carries meaning.
    out property <duration> hold-duration: 3s;
    out property <duration> hold-tick: 50ms;
    out property <length> hold-bar: 6px;

    // §11.5's outbound animation. **4 fps** is the frame rate 03-transport.md §6 names and the
    // rate the recovery-time arithmetic was computed at, so keeping it keeps those numbers valid.
    out property <duration> outbound-frame: 250ms;
    // The quiet zone, in modules. Four is the standard's own minimum, and it is the painter's
    // rather than the encoder's: it is background, not data (`aobs-core::outbound`).
    out property <int> quiet-zone: 4;
    out property <length> outbound-heading: 34px;
    out property <length> outbound-note: 46px;
    out property <length> outbound-action: 66px;
    out property <length> outbound-spacing: 18px;
    // What the chrome and the three text rows leave for the symbol itself. The shell hands the
    // side length in rather than the layout deriving it, for the reason `review-room` is handed
    // in: a square whose side is a function of the space left over is a constraint derived from
    // the width it produces.
    out property <length> outbound-chrome: root.outbound-heading + root.outbound-note
        + root.outbound-action + 3 * root.outbound-spacing;
}

export global Palette {
    out property <color> ground: #eef1f5;
    out property <color> panel: #ffffff;
    out property <color> line-soft: #dfe5ec;
    out property <color> ink: #0f151c;
    out property <color> ink-mid: #414d5c;
    out property <color> ink-dim: #66717f;
    // §0: darkened from the dark scheme's value to hold contrast against a white panel.
    out property <color> focus: #14468f;
    // 04-screens.md §0's palette names `--crit` and says the dark-scheme values are darkened to
    // hold contrast against a white panel; this is that value. It is the first token past
    // `focus` to have a consumer: a refusal at the QR boundary (§11.1) is the first thing this
    // appliance draws that is neither navigation nor a fact about the wallet.
    out property <color> crit: #8f1d1d;
}

// One row of a ring. `note` carries the stated reason when a row is unavailable — 01-boot
// -layer.md §7 and 04-screens.md §1 both require *visibly unavailable with the reason
// stated*, never hidden — and a plain sub-line otherwise.
component Choice inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> available: true;
    in property <bool> current: false;
    // A selector row (04-screens.md §5.2), which needs a signal for something no other row has:
    // *what the appliance will use*, which is not the same fact as *where the cursor is*. Two
    // independent facts need two independent signals, so `current` keeps the border and the
    // weight and `chosen` gets a disc of its own — a shape rather than a glyph, for the reason
    // the retype's caret is a 2 px rule.
    in property <bool> mark: false;
    in property <bool> chosen: false;

    height: 66px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.current ? Palette.focus : Palette.line-soft;
    background: root.current ? Palette.ground : Palette.panel;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                alignment: start;
                spacing: root.mark ? 10px : 0px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        visible: root.mark;
                        width: root.mark ? 13px : 0px;
                        height: root.mark ? 13px : 0px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: root.chosen ? Palette.focus : Palette.ink-dim;
                        background: root.chosen ? Palette.focus : Palette.panel;
                    }
                }

                Text {
                    text: root.label;
                    color: root.available ? Palette.ink : Palette.ink-dim;
                    font-size: 19px;
                    font-weight: root.current ? 600 : 400;
                }
            }

            Text {
                text: root.note;
                visible: root.note != "";
                color: Palette.ink-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

component Heading inherits Text {
    color: Palette.ink;
    font-size: 26px;
    font-weight: 600;
}

// A run of monospace groups separated by 04-screens.md §0's **sub-cell gap of about 0.25 em,
// never a space character occupying a full monospace cell.** One component, because the two
// places that grouping appears must not disagree about the gap: an address in 4-character
// groups (§0) and the fee's satoshi digits in threes (§11.2.1). The group *size* differs
// because the jobs do — four for characters compared one at a time, three for digits read as
// a magnitude — and neither is this component's business: it is handed groups.
//
// Single-line. The wrapping case is [`AddressBlock`], and it is separate because wrapping
// needs the width it is wrapping into, which a satoshi amount never comes close to.
component Grouped inherits HorizontalLayout {
    in property <[string]> groups;
    in property <length> size;
    in property <color> ink: Palette.ink;
    in property <int> weight: 400;

    alignment: start;
    spacing: 0.25 * root.size;

    for group in root.groups: Text {
        text: group;
        color: root.ink;
        font-family: "DejaVu Sans Mono";
        font-size: root.size;
        font-weight: root.weight;
        vertical-alignment: center;
    }
}

// One address at full width, in §0's 4-character groups, **wrapped where the column is still
// narrower than the address and never truncated.**
//
// The layout is arithmetic rather than a flow, and the arithmetic needs the width of a group.
// **That width is measured, not stated.** `ruler` is a hidden Text carrying one group in the
// same face and size the groups are drawn in, so `group-width` is what this font actually
// renders rather than a metric copied out of a font table — which is the difference between an
// assertion about the shipped ISO and an assertion about our arithmetic. The owed measurement
// in 00-overview.md is discharged from this property (`main.rs`, `AOBS_REVIEW`).
//
// `room` is handed in rather than read off `self.width`. The height of this element depends on
// how many lines the groups take, which depends on the width — and a layout whose constraint
// is derived from the width it produces is the shape Slint reports as a binding loop. It comes
// from `display::room`, which owns the same arithmetic the console line is printed from, so the
// number the panel wraps against and the number CI asserts are one number.
component AddressBlock inherits Rectangle {
    in property <[string]> groups;
    in property <length> size;
    in property <length> room;
    // §0: **both ends emphasised — the emphasis carried by weight and ink, not luminance.**
    // Off for a change or input address, which is verified or ours and is not being compared
    // against anything.
    in property <bool> emphasise: true;

    ruler := Text {
        text: "0000";
        font-family: "DejaVu Sans Mono";
        font-size: root.size;
        visible: false;
    }

    out property <length> group-width: ruler.preferred-width;
    out property <length> gap: 0.25 * root.size;
    out property <length> line: 1.3 * root.size;
    property <int> per-line: Math.max(1,
        Math.floor((root.room + root.gap) / (root.group-width + root.gap)));
    out property <int> lines: Math.ceil(root.groups.length / root.per-line);

    height: root.lines * root.line;

    for group[i] in root.groups: Text {
        x: Math.mod(i, root.per-line) * (root.group-width + root.gap);
        y: Math.floor(i / root.per-line) * root.line;
        height: root.line;
        text: group;
        color: root.emphasise && (i == 0 || i == root.groups.length - 1)
            ? Palette.ink : Palette.ink-mid;
        font-family: "DejaVu Sans Mono";
        font-size: root.size;
        font-weight: root.emphasise && (i == 0 || i == root.groups.length - 1) ? 700 : 400;
        vertical-alignment: center;
    }
}

// One money fact: 04-screens.md §11.2.1's label above the digits, with **the unit as a
// separate label, dimmer and smaller** — and `BTC` on both networks, because ADR-0015 makes a
// testnet session look identical and a unit label is the one place the money would have leaked
// the network.
component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> unit: "BTC";

    Text {
        text: root.label;
        height: Metrics.fact-label;
        color: Palette.ink-dim;
        font-size: 13px;
        vertical-alignment: center;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 6px;

        Text {
            text: root.value;
            height: Metrics.fact-value;
            color: Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: Metrics.address-size;
            vertical-alignment: center;
        }

        Text {
            text: root.unit;
            visible: root.unit != "";
            height: Metrics.fact-value;
            color: Palette.ink-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

// 04-screens.md §1. A flat three-entry menu, labelled by the input the user is holding —
// paper with words, or a QR — because labelling by artifact fails: the encrypted QR is a
// re-encoding of the mnemonic, so "backup" names both artifacts. No submenu, and no way
// back here later: this is a boot-time menu, not a mode switch (ADR-0010).
component StartMenu inherits Rectangle {
    in property <bool> camera;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 22px;

        Heading {
            text: "What are you holding?";
        }

        VerticalLayout {
            spacing: 10px;

            Choice {
                label: "Create a new wallet";
                note: "24 words, generated here, on paper before anything else happens.";
                current: root.selected == 0;
            }

            Choice {
                label: "Type a seed phrase";
                note: "You have the words on paper.";
                current: root.selected == 1;
            }

            Choice {
                label: "Scan an encrypted backup";
                // Not hidden, and the reason is on screen rather than in a manual.
                note: root.camera
                    ? "You have the QR this appliance printed for you, and the eight words that unlock it."
                    : "Unavailable: no camera was found. Plug in a USB webcam and start over, or type the words instead.";
                available: root.camera;
                current: root.selected == 2;
            }
        }

        Text {
            text: "One wallet per boot. There is no way back to this menu.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

// 04-screens.md §2. **One screen doing both jobs**: the rolls are needed before the mnemonic
// exists, which is exactly when `getrandom(2)` is still blocking, so the dead time carries
// the optional feature at the cost of no extra step — and a screen with something to do on
// it cannot read as a hang.
//
// What is *not* here is the specification (02-core.md §3): no minimum, no bit counter, no
// progress meter, no distribution check, and **no running hash of the rolls**. The roll
// count is the whole of what this screen says about them, because the rolls are mixed rather
// than substituted and a hash on screen would hand back the property that makes that safe.
//
// The wait is indeterminate with elapsed seconds and no percentage, and it **only unlocks
// Continue**: nothing here advances on its own, because the user may still be rolling.
component DiceScreen inherits Rectangle {
    in property <int> rolls;
    in property <int> wait-seconds;
    in property <bool> ready;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 16px;

        Heading {
            text: "Dice, if you want them";
        }

        // The mandated line of copy, on the screen where it will actually be read.
        Text {
            text: "Your rolls are combined with the system random number generator. "
                + "They can only add randomness, never remove it.";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: "Type your rolls as digits, 1 to 6. Stop whenever you like.";
            color: Palette.ink-dim;
            font-size: 13px;
            wrap: word-wrap;
        }

        // The count, and nothing else. Zero is stated as an answer rather than as an empty
        // field, because it is one: with no supplement the entropy is `getrandom`'s bytes
        // verbatim, and nothing about this screen is a requirement (02-core.md §3).
        Text {
            text: root.rolls == 0
                ? "nothing rolled yet — that is a complete answer"
                : "rolls: " + root.rolls;
            color: root.rolls == 0 ? Palette.ink-dim : Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: 20px;
        }

        Choice {
            label: "Continue";
            // The wait, stated as what it is. Seconds because they are known; no bar,
            // because `getrandom(2)` reports no progress and a fabricated one stalling near
            // the end reads more like a hang than a spinner does (04-screens.md §2).
            note: root.ready
                ? "The system random number generator is ready."
                : "Waiting for the system random number generator — " + root.wait-seconds + " s. "
                    + "Keep rolling, or wait.";
            available: root.ready;
            current: root.selected == 0;
        }
    }
}

// One numbered word. The row height is Metrics' and not this component's, because it is a
// term in the owed measurement above.
component WordRow inherits Rectangle {
    in property <Word> word;
    // 04-screens.md §4: a wrong word in the retype returns here with its position marked for
    // repair. The mark is on the row rather than in the copy because the copy already names
    // the number, and what the user needs next is to find that line on the paper.
    in property <bool> marked;

    height: Metrics.word-row;
    border-radius: 3px;
    background: root.marked ? Palette.ground : transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.word.position;
            width: 28px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.marked ? Palette.focus : Palette.ink-dim;
            font-family: "DejaVu Sans Mono";
            font-size: 14px;
        }

        Text {
            text: root.word.text;
            vertical-alignment: center;
            color: Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: 17px;
        }
    }
}

// 04-screens.md §3. **Two column-major columns of 12 — 1–12 left, 13–24 right, all visible
// at once.** The fill is the argument: a column of twelve is the shape of the card or steel
// plate being copied onto, so screen and destination share a geometry and the copy becomes
// positional rather than sequential. A row-flow grid renders 1,2 / 3,4 and inverts it, which
// is why the two columns arrive as two models built and tested in Rust rather than as one
// list this file slices.
//
// **No pages.** A page turn sits exactly where a place gets lost during transcription, and it
// makes cross-checking impossible when half the phrase is never on screen with the other half.
component Words inherits Rectangle {
    in property <[Word]> left;
    in property <[Word]> right;
    // The position the retype rejected, 1-based, or 0 when the phrase is simply being
    // written down for the first time.
    in property <int> marked;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: Metrics.words-gap;

        // The instructional banner. It stays because it carries information, and its height
        // is fixed because it is a term in the measurement.
        VerticalLayout {
            height: Metrics.words-banner;
            spacing: 6px;

            Text {
                // The repair copy names the position, because naming the position *is* the
                // repair (04-screens.md §4) — and it names both possibilities, because the
                // appliance knows a word came back different and not which side was wrong.
                text: root.marked == 0
                    ? "Write these 24 words on paper, in this order."
                    : "What you typed for word " + root.marked + " is not word " + root.marked + ".";
                color: Palette.ink;
                font-size: 20px;
                font-weight: 600;
            }

            Text {
                text: root.marked == 0
                    ? "They are the only copy. Anyone who has them has the wallet, and nothing here is stored."
                    : "Check that line against your paper, fix whichever is wrong, and carry on. Nothing you typed is lost.";
                color: Palette.ink-mid;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 28px;

            VerticalLayout {
                for word in root.left: WordRow {
                    word: word;
                    marked: word.position == root.marked;
                }
            }

            VerticalLayout {
                for word in root.right: WordRow {
                    word: word;
                    marked: word.position == root.marked;
                }
            }
        }

        Choice {
            height: Metrics.words-continue;
            // 04-screens.md §4 rejects a `restart` control by name: it voids everything
            // already written down and re-asks the same transcription of someone who has just
            // proved they can slip. So there is one row here on both visits, and on the second
            // it says what it does — carry on from where the rejection left off.
            label: root.marked == 0 ? "I have written them down" : "Carry on typing";
            current: root.selected == 0;
        }
    }
}

// One slot of the retype. The row height is Metrics' — the same 26 px the phrase is drawn at,
// because the two screens are the same twelve-and-twelve geometry and the sum that has to fit
// the 800×600 floor is one number for both (04-screens.md §3's measurement).
component SlotRow inherits Rectangle {
    in property <Slot> slot;

    height: Metrics.word-row;
    border-radius: 3px;
    background: root.slot.current ? Palette.ground : transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.slot.position;
            width: 28px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.slot.current ? Palette.focus : Palette.ink-dim;
            font-family: "DejaVu Sans Mono";
            font-size: 14px;
        }

        HorizontalLayout {
            alignment: start;
            // Explicit, because the buffer and its ghosted completion have to read as one
            // word: `abandon` typed as `aban` plus `don` cannot be `aban don`.
            spacing: 0px;

            Text {
                text: root.slot.text;
                vertical-alignment: center;
                color: Palette.ink;
                font-family: "DejaVu Sans Mono";
                font-size: 17px;
            }

            // The single remaining word, ghosted inline (04-screens.md §6). It completes the
            // word being typed and never proposes one — the appliance supplies no key material
            // the user did not (02-core.md §4, behaviour 5).
            Text {
                text: root.slot.ghost;
                vertical-alignment: center;
                color: Palette.ink-dim;
                font-family: "DejaVu Sans Mono";
                font-size: 17px;
            }

            // The caret: a 2 px rule rather than a glyph, so it needs no font coverage and
            // cannot be misread as a letter of the word being typed.
            Rectangle {
                width: 2px;
                background: Palette.focus;
                visible: root.slot.current;
            }
        }
    }
}

// 04-screens.md §4. **The full 24-word retype, typed from paper, with the phrase off screen.**
//
// The arithmetic is what settles it: against a single mis-copied word — the top loss mode, the
// one that surfaces years later — ticking *written down* detects 0% and a four-position sample
// detects 4/24. The full retype detects all of it, and buys the thing neither alternative can:
// the user rehearses the restore while the paper is still fresh enough to correct.
//
// **The reframe that decides everything on this screen: it is not a gate proving the phrase was
// written down, it is an instrument for making the paper correct — so a failure is the feature
// working.** Hence: committed words are echoed, because an off-by-one has to be visible as a
// *shift* rather than as a mystery rejection at word 20; nothing is masked; a rejection names
// the position and destroys nothing; and there is **no restart control** anywhere on it.
component RetypeScreen inherits Rectangle {
    in property <[Slot]> left;
    in property <[Slot]> right;
    in property <string> note;
    in property <int> settled;
    in property <bool> done;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: Metrics.words-gap;

        VerticalLayout {
            height: Metrics.words-banner;
            spacing: 6px;

            Text {
                text: "Type the 24 words from your paper.";
                color: Palette.ink;
                font-size: 20px;
                font-weight: 600;
            }

            // The live line, and it sits *inside* the banner's fixed height rather than as a
            // row of its own: that height is a term in §3's measurement, and this screen is
            // built from the same numbers so the same sum covers both.
            Text {
                text: root.note;
                color: Palette.ink-mid;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 28px;

            VerticalLayout {
                for slot in root.left: SlotRow {
                    slot: slot;
                }
            }

            VerticalLayout {
                for slot in root.right: SlotRow {
                    slot: slot;
                }
            }
        }

        Choice {
            height: Metrics.words-continue;
            label: "Done";
            note: root.done
                ? "Press Enter to finish."
                : root.settled + " of 24 typed.";
            available: root.done;
            current: root.selected == 0;
        }
    }
}

// 04-screens.md §5. **One screen, always present, on every load path** — created, imported or
// restored. It carries the two parameters that enter at derivation rather than at generation,
// and the rejected alternative is a menu branch ("load wallet" / "load wallet with
// passphrase"): a branch is where people take the wrong one, and it makes the passphrase feel
// like a mode rather than a field.
//
// **The network sits above the passphrase and that order is forced**, not preferred: the
// confirm control's label is a function of whether the field is empty, so the passphrase has to
// be the last thing touched before confirming. A selector below it would be reached after the
// label had already settled.
//
// The heights add up, against the 458 px the chrome leaves inside the 800×600 floor — the same
// sum §3's `AOBS_WORDS` line takes for the words screen:
//
//   34 heading + 14 + 38 copy + 14 + 150 network + 14 + 100 field + 14 + 66 confirm = 444
//
// The field is two lines of 26 px because 128 characters and two delimiters at 17 px monospace
// are about 1,330 px against the floor's ~752 px of usable width, so a full-length passphrase
// wraps exactly once and can wrap no further: three lines would need a monospace advance wider
// than the type size.
component LoadScreen inherits Rectangle {
    in property <bool> testnet;
    // Already rendered by the shell: delimited, and with every space drawn as a mark. This
    // property is a string to *draw* and carries no structure for this file to interpret.
    in property <string> passphrase;
    in property <int> count;
    in property <string> note;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 14px;

        Heading {
            text: "Load the wallet";
        }

        VerticalLayout {
            spacing: 4px;

            // §5.1: **the screen names the layout before the user starts.** The field is
            // printable ASCII only and group 1 of `us` reaches all 95 of those characters, so on
            // a German, French or Brazilian board nothing is unreachable — the legends are
            // simply wrong. A stated fact beats a mystery under the fingers, and a picker was
            // rejected because a wrongly-picked `de` imports dead keys, which is an *invisible*
            // mode where a wrong legend is a visible one.
            Text {
                text: "US keyboard layout. Other boards reach every character; only the legends are wrong.";
                color: Palette.ink-mid;
                font-size: 13px;
                wrap: word-wrap;
            }

            // The one line of copy that replaces the strength UI. No meter, no minimum, no
            // double entry, no lecture (02-core.md §5).
            Text {
                text: "A passphrase is never checked and never recoverable.";
                color: Palette.ink-mid;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // §5.2. **Two states, not three**: nothing in a key, an address or a descriptor
        // distinguishes testnet from signet, so a third state would be a label with no derivable
        // consequence. Mainnet is preselected and the pick is not forced — the user can confirm
        // straight through. The copy states what the selection is for and nothing else: no
        // advice, and no confirmation step for choosing testnet.
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Network";
                color: Palette.ink-dim;
                font-size: 13px;
            }

            Choice {
                height: 58px;
                mark: true;
                chosen: !root.testnet;
                label: "Mainnet";
                note: "Real coins.";
                current: root.selected == 0;
            }

            Choice {
                height: 58px;
                mark: true;
                chosen: root.testnet;
                label: "Testnet / signet";
                note: "For rehearsal. Coins on it are not real.";
                current: root.selected == 1;
            }
        }

        // §5.1. **Clear text, always, no toggle**, and rendering is the mitigation: fixed-width,
        // spaces drawn as a visible mark, explicit start and end delimiters, character count
        // shown, never trimmed. Masked-with-a-reveal-toggle is the worst of the three shapes,
        // because it makes clear text an opt-in that a hurrying user skips.
        //
        // Not a ring row. There is exactly one field on this screen, so every printable key
        // lands in it whichever row the cursor is on — which is why the line below says so
        // rather than leaving the user to discover it.
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Passphrase — optional. Every printable key lands here; Backspace removes one.";
                color: Palette.ink-dim;
                font-size: 13px;
            }

            Text {
                text: root.passphrase;
                color: Palette.ink;
                font-family: "DejaVu Sans Mono";
                font-size: 17px;
                height: 52px;
                vertical-alignment: top;
                wrap: char-wrap;
            }

            // The count, and the refusal line when there is one. A rejected keystroke says so
            // (§5.1), and it takes this line rather than a line of its own, so the block's height
            // is the same whether a key was refused or not.
            Text {
                text: root.note != ""
                    ? root.note
                    : root.count + " of 128 characters. Spaces show as ·, and nothing is trimmed.";
                color: root.note != "" ? Palette.focus : Palette.ink-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // §5.1: **the confirm control states which of the two is happening.** An accidental empty
        // confirm cannot pass as a deliberate one, which is the whole job of this label.
        Choice {
            height: 66px;
            label: root.count == 0 ? "Continue without passphrase" : "Use this passphrase";
            note: root.count == 0
                ? "The ordinary case. Your 24 words are the whole of the wallet."
                : "The wallet comes from your 24 words and this passphrase together.";
            current: root.selected == 2;
        }
    }
}

// 04-screens.md §7. **The hub**, shown after every load and reachable all session.
//
// Always in view: master fingerprint, network, script type, and whether a passphrase is in use.
// The fingerprint is what a user with an existing wallet compares against their coordinator —
// adequate here despite being a hint-only value for derivation, because here it faces a typo
// rather than an attacker choosing collisions, and a typo cannot collide.
//
// **The network line stands alone and carries its weight by itself.** The fingerprint is
// byte-identical on both networks (02-core.md §6), so it catches a passphrase typo and cannot
// catch a network mistake; there is no second signal, which is why the copy states the network
// in both directions and never as an absence.
//
// **Nothing else about a testnet session differs** — same chrome, same colours, no rehearsal
// livery. A rehearsal has to look identical to the real thing or it is not a rehearsal, and a
// mode dressed as a toy would teach the user to click through the exact ceremony we want
// rehearsed.
//
//   130 facts + 14 + 240 actions = 384, against the floor's 458.
component IdentityScreen inherits Rectangle {
    in property <string> fingerprint;
    in property <bool> testnet;
    in property <bool> passphrase-in-use;
    in property <[Account]> accounts;
    in property <bool> camera;
    // Whether §7's re-display row exists at all (02-core.md §12).
    in property <bool> signed;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 14px;

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                alignment: start;
                spacing: 12px;

                Text {
                    text: "Master fingerprint";
                    color: Palette.ink-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.fingerprint;
                    color: Palette.ink;
                    font-family: "DejaVu Sans Mono";
                    font-size: 20px;
                    font-weight: 600;
                }
            }

            Text {
                text: root.testnet
                    ? "Testnet / signet. This is not mainnet, and coins here are not real."
                    : "Mainnet. This is not testnet or signet, and coins here are real.";
                color: Palette.ink;
                font-size: 14px;
                wrap: word-wrap;
            }

            Text {
                text: root.passphrase-in-use
                    ? "A passphrase is in use."
                    : "No passphrase is in use.";
                color: Palette.ink;
                font-size: 14px;
            }

            // All four, always, because all four are derived (02-core.md §6). No script-type
            // choice is offered anywhere, so this is a statement rather than a selection — and
            // it is the answer to *"is your old wallet BIP44 or BIP84?"*, a question the product
            // refuses to ask because the user cannot referee it.
            VerticalLayout {
                for account in root.accounts: HorizontalLayout {
                    height: 17px;
                    alignment: start;
                    spacing: 10px;

                    Text {
                        text: account.family;
                        width: 58px;
                        color: Palette.ink-mid;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                    }

                    Text {
                        text: account.script;
                        width: 110px;
                        color: Palette.ink;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                    }

                    Text {
                        text: account.path;
                        color: Palette.ink-dim;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                    }
                }
            }
        }

        // §7's table, in its order. The two camera rows stay visible with the reason stated
        // rather than being hidden, the same rule the start menu's third entry follows — and they
        // are adjacent, which is what the frame's `move` had to grow a link for.
        VerticalLayout {
            spacing: 8px;

            Choice {
                height: 54px;
                label: "Show the watch-only export";
                note: "One QR for your coordinator. Public keys only.";
                current: root.selected == 0;
            }

            Choice {
                height: 54px;
                label: "Sign a transaction";
                note: root.camera
                    ? "Scan the transaction QR."
                    : "Unavailable: no camera was found.";
                available: root.camera;
                current: root.selected == 1;
            }

            Choice {
                height: 54px;
                label: "Verify a receive address";
                note: root.camera
                    ? "Scan an address QR and check it is one of ours."
                    : "Unavailable: no camera was found.";
                available: root.camera;
                current: root.selected == 2;
            }

            // §7's fifth row, which **appears** once a transaction has been signed this session
            // rather than greying before then — there is no state for it to be in, and a greyed
            // row states a reason, which here would be *you have not signed anything*.
            //
            // **One slot, and the copy says so** (02-core.md §12): *most recently* is
            // load-bearing, because signing again replaces what this row shows. There is no list
            // and no selection UI, which is the point — with no names, no labels and no clock the
            // only distinguishing facts would be amount and destination, exactly what §11.5
            // removes from this path.
            if root.signed: Choice {
                height: 54px;
                label: "Show the last signed transaction again";
                note: "The most recent one. Signing another replaces it.";
                current: root.selected == 3;
            }

            // **Secondary, and its position is forced rather than chosen**: the
            // passphrase-in-use bit rides in the backup's AAD, so the backup cannot exist before
            // the passphrase is known (ADR-0007, 02-core.md §11).
            Choice {
                height: 54px;
                label: "Export an encrypted backup";
                note: "Eight words, and a QR that needs them.";
                // Parenthesised for the reason the frame's own `available` is: a reader should
                // not have to be sure of `?:` against `==` to know which row this is.
                current: root.signed ? (root.selected == 4) : (root.selected == 3);
            }
        }
    }
}

// 04-screens.md §11.1. One component, three configurations — and the configuration is two
// properties, not three copies of this file: `heading` names what this screen wants and
// `multi-part` says whether a fraction of parts exists to report. Both come from the payload
// class, in core.
//
// Three things here are the spec rather than taste:
//
//   * **The preview is greyscale because it is the luma plane**, not because grey was chosen.
//     It displays exactly what the decoder sees rather than a prettier version of it, and
//     `pixelated` is part of that: a smoothing filter would show the user a cleaner picture
//     than `rqrr` is working from, on the one screen whose whole purpose is aiming.
//   * **The progress element does not appear for a single-part class.** Absent, not zeroed:
//     the address and backup classes never touch the fountain decoder, so there is no
//     fraction that could be reported truthfully.
//   * **Nothing else is reachable while the camera is up.** This screen contributes no rows
//     to the ring while it is live, so the only keys that do anything are Escape and the
//     frame's own always-available row (§7) — which lands on a confirm rather than an action.
component ScanScreen inherits Rectangle {
    in property <string> heading;
    in property <image> preview;
    in property <string> progress;
    in property <bool> multi-part;
    in property <string> note;
    in property <string> code;
    in property <bool> stopped;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 16px;

        Heading {
            text: root.heading;
        }

        if !root.stopped: VerticalLayout {
            alignment: start;
            spacing: 12px;

            Rectangle {
                width: Metrics.preview-width;
                height: Metrics.preview-height;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.line-soft;
                background: Palette.ground;

                Image {
                    source: root.preview;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            // `if`, not `visible` — a layout still gives an invisible child its space, and
            // §11.1's *simply does not appear* is about the element and not about its ink. For
            // the one class that has parts the row is here from the first frame, saying what is
            // true then, so the layout does not jump when the first one lands.
            if root.multi-part: Text {
                text: root.progress == ""
                    ? "Waiting for the first frame of the animation."
                    : root.progress + " frames of the animation received.";
                color: Palette.ink-mid;
                font-family: "DejaVu Sans Mono";
                font-size: 15px;
            }

            Text {
                text: "Escape cancels, from the first frame.";
                color: Palette.ink-dim;
                font-size: 13px;
            }
        }

        // A refusal, or a camera that stopped answering. It is outside the block above because
        // §11.1 keeps the screen live after a wrong-class payload: the sentence and the
        // preview are on screen together, which is what makes it an invitation to point the
        // camera elsewhere rather than a dead end.
        if root.note != "": Rectangle {
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.crit;
            background: Palette.panel;

            HorizontalLayout {
                padding: 16px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: root.note;
                        color: Palette.ink;
                        font-size: 17px;
                        wrap: word-wrap;
                    }

                    // Absent rather than blank when there is no code: a camera that was
                    // unplugged refused nothing (06-codes.md §4), and an empty line where a
                    // code goes reads as one that failed to print.
                    if root.code != "": Text {
                        text: root.code;
                        color: Palette.crit;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                    }
                }
            }
        }

        if root.stopped: Choice {
            label: "Go back";
            note: "The camera is off. Nothing was signed and nothing was saved.";
            current: root.selected == 0;
        }
    }
}

// §11.2.1's **second form in satoshis that no other row carries** — grouped in threes with §0's
// gap, because the fee is the number the eight-decimal form serves worst and the only one
// compared against a market quoted in satoshis.
component FeeSat inherits HorizontalLayout {
    in property <[string]> sat;

    height: Metrics.fee-detail;
    alignment: start;
    spacing: 5px;

    Grouped {
        groups: root.sat;
        size: 14px;
        ink: Palette.ink-mid;
    }

    Text {
        text: "sat";
        color: Palette.ink-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}
component FeeRate inherits Text {
    in property <string> rate;

    text: root.rate + " sat/vB";
    height: Metrics.fee-detail;
    color: Palette.ink-mid;
    font-family: "DejaVu Sans Mono";
    font-size: 14px;
    vertical-alignment: center;
}
// **Absent for a consolidation.** §11.2.1: the ratio is undefined with no non-change outputs,
// and the formatter returns nothing rather than a zero, an infinity or a dash — so the absence
// stays typed all the way to here, and this element does not exist rather than showing a dash.
component FeePercent inherits Text {
    in property <string> percent;

    text: root.percent + "% of the amount paying";
    height: Metrics.fee-detail;
    color: Palette.ink-mid;
    font-size: 14px;
    vertical-alignment: center;
}
// The fee's three secondary readings, on one line: §11.2.1's **second form in satoshis that no
// other row carries** — grouped in threes with §0's gap, because the fee is the number the
// eight-decimal form serves worst and the only one compared against a market quoted in satoshis
// — then the rate, then the percentage.
//
// **The percentage is absent for a consolidation.** §11.2.1: the ratio is undefined with no
// non-change outputs, and the formatter returns nothing rather than a zero, an infinity or a
// dash — so the absence stays typed all the way to here.
component FeeDetail inherits Rectangle {
    in property <[string]> sat;
    in property <string> rate;
    in property <string> percent;
    in property <bool> stacked;

    // One line at the narrow breakpoint, three in the rail. **Which way round is deliberate:**
    // the stacked state has 752 px of width and 458 px of height, the rail has 300 and 658, and
    // `Metrics.fee-detail` is the stacked height because that is the state the owed measurement
    // is taken in. Found by building it — the one-line form is about 353 px and drew straight
    // over the output column.
    height: root.stacked ? Metrics.fee-detail : 3 * Metrics.fee-detail;

    if root.stacked: HorizontalLayout {
        alignment: start;
        spacing: 14px;

        FeeSat {
            sat: root.sat;
        }

        FeeRate {
            rate: root.rate;
        }

        if root.percent != "": FeePercent {
            percent: root.percent;
        }
    }

    if !root.stacked: VerticalLayout {
        alignment: start;

        FeeSat {
            sat: root.sat;
        }

        FeeRate {
            rate: root.rate;
        }

        if root.percent != "": FeePercent {
            percent: root.percent;
        }
    }
}




// 04-screens.md §11.2's one advisory warning, **inline on the fee row**, as a full sentence in
// colour and weight.
//
// No icon — an icon needs a legend and there is nowhere to put one. No banner and no dedicated
// screen — either would sever the statement from the number it is about and manufacture a
// dismissal keystroke. And **no acknowledgement**: there is nothing to acknowledge and no key to
// press, so this is text and not a control.
//
// The sentence arrives written, from the one `match` over core's typed variant (`review.rs`).
// Nothing here re-tests the condition that produced it (02-core.md §9).
component FeeNote inherits Text {
    // A **minimum**, not a height. The sentence is one line in the 752 px the stacked state
    // gives it — which is what `Metrics.fee-note` reserves — and two in the rail, where a fixed
    // height clipped the second one.
    min-height: Metrics.fee-note;
    color: Palette.crit;
    font-size: 14px;
    font-weight: 600;
    vertical-alignment: center;
    wrap: word-wrap;
}

// §11.2's money facts, in both of §0's two states and **nothing dropped in either**: it is the
// same six facts, in one column instead of two.
//
// **A layout and not a Rectangle.** A conditional child of a Rectangle is absolutely positioned
// and contributes no height, so a reflowing block built that way reports nothing to the layout
// above it and draws straight through whatever follows. Found by building it.
//
// The fee's two continuation lines are siblings of both branches rather than inside them, so
// they are the same two elements at both breakpoints — and in both they sit directly under the
// Fee cell, which is what *inline on the fee row* comes to once the facts are a grid.
component MoneyFacts inherits VerticalLayout {
    in property <string> leaving;
    in property <string> paying;
    in property <string> returning;
    in property <string> inputs;
    in property <string> input-total;
    in property <string> fee;
    in property <[string]> fee-sat;
    in property <string> fee-rate;
    in property <string> fee-percent;
    in property <string> warning;
    in property <bool> stacked;

    alignment: start;

    // Stacked: two rows of cells, which hands the whole width to the address column below
    // (§0's second breakpoint). The Fee leads the second row so its continuation lines land
    // under it.
    if root.stacked: VerticalLayout {
        spacing: Metrics.facts-spacing;

        HorizontalLayout {
            spacing: 18px;

            Fact {
                label: "Leaving this wallet";
                value: root.leaving;
            }

            Fact {
                label: "Paying the recipients";
                value: root.paying;
            }

            Fact {
                label: "Returning to this wallet";
                value: root.returning;
            }
        }

        HorizontalLayout {
            spacing: 18px;

            Fact {
                label: "Fee";
                value: root.fee;
            }

            Fact {
                label: "Inputs";
                value: root.inputs;
                unit: "";
            }

            Fact {
                label: "Input total";
                value: root.input-total;
            }
        }
    }

    // The fixed left rail (§11.2): the same facts read down instead of across, in the same
    // order, so a user who has seen one breakpoint recognises the other.
    if !root.stacked: VerticalLayout {
        spacing: Metrics.facts-spacing;

        Fact {
            label: "Leaving this wallet";
            value: root.leaving;
        }

        Fact {
            label: "Paying the recipients";
            value: root.paying;
        }

        Fact {
            label: "Returning to this wallet";
            value: root.returning;
        }

        Fact {
            label: "Fee";
            value: root.fee;
        }
    }

    FeeDetail {
        sat: root.fee-sat;
        rate: root.fee-rate;
        percent: root.fee-percent;
        stacked: root.stacked;
    }

    // Absent rather than blank when nothing fired. The sum above reserves its height anyway,
    // so the panel is measured against the transaction that trips it.
    if root.warning != "": FeeNote {
        text: root.warning;
    }

    if !root.stacked: VerticalLayout {
        spacing: Metrics.facts-spacing;
        padding-top: Metrics.facts-spacing;

        Fact {
            label: "Inputs";
            value: root.inputs;
            unit: "";
        }

        Fact {
            label: "Input total";
            value: root.input-total;
        }
    }
}

// One output row: what it is, what it pays, and the address at full width beneath it.
//
// **Change is presented as settled, not as a thing to check** (§11.2) — labelled as re-derived
// from the seed at its path and matched byte for byte. That sentence comes from core's verdict
// and is absent when there is none, which is what keeps it honest: the statement exists exactly
// where the byte-compare ran.
component OutputRow inherits VerticalLayout {
    in property <Output> output;
    in property <length> room;

    // A **minimum**, and a layout rather than a Rectangle so it is one: an address that wraps
    // has to grow the row, because §0 says it is never truncated and a fixed row height would
    // have drawn the second line over the next output. Found by building it.
    min-height: Metrics.output-row;
    alignment: start;
    spacing: 3px;

    HorizontalLayout {
        height: Metrics.output-label;
        spacing: 8px;

        Text {
            text: root.output.index;
            width: 16px;
            color: Palette.ink-dim;
            font-family: "DejaVu Sans Mono";
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.output.label;
            color: Palette.ink;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // The one thing on this panel that may be shortened, and §0 says which: change and
        // input addresses may be, *because they are verified or ours*. This is not an address
        // at all — it is the statement about one — and the path it names is repeated on §11.3's
        // screen for every payment. A payment address is never elided anywhere.
        Text {
            text: root.output.settled;
            visible: root.output.settled != "";
            color: Palette.ink-dim;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.output.amount;
            color: Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: "BTC";
            color: Palette.ink-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    AddressBlock {
        groups: root.output.groups;
        size: Metrics.address-size;
        room: root.room;
    }
}

// The output list and the one control the panel carries. Its own component so the two
// breakpoints hang the same thing in two places rather than two copies of it.
component Outputs inherits VerticalLayout {
    in property <[Output]> outputs;
    in property <length> room;
    in property <int> selected;

    alignment: start;
    spacing: Metrics.review-spacing;

    Text {
        text: "Outputs";
        height: Metrics.outputs-header;
        color: Palette.ink-dim;
        font-size: 13px;
        letter-spacing: 0.8px;
        vertical-alignment: center;
    }

    VerticalLayout {
        for output in root.outputs: OutputRow {
            output: output;
            room: root.room;
        }
    }

    // §11.3: pressing sign walks one full-width screen per payment address **before** the
    // signature is produced. The label says so, because a control that said *sign* and then
    // showed another screen would have lied about what the press does.
    Choice {
        height: Metrics.review-action;
        label: "Sign this transaction";
        note: "Each payment address is shown on its own screen first.";
        current: root.selected == 0;
    }
}

// 04-screens.md §11.2. **A single non-scrolling panel carrying the whole transaction** — no
// `Flickable`, no `ScrollView` and no clipped region anywhere in it, which is why the two
// numbers `main.rs` prints are the guard rather than a comment: the panel cannot hide an
// overflow, so a canvas it does not fit is a boot CI fails.
//
// **Nothing that should stop a transaction appears here.** Refusals happen in core before this
// screen is drawn at all (02-core.md §7), and the one thing on it that is neither a number nor
// an address is the advisory sentence on the fee row.
component ReviewPanel inherits VerticalLayout {
    in property <string> leaving;
    in property <string> paying;
    in property <string> returning;
    in property <string> inputs;
    in property <string> input-total;
    in property <string> fee;
    in property <[string]> fee-sat;
    in property <string> fee-rate;
    in property <string> fee-percent;
    in property <string> warning;
    in property <[Output]> outputs;
    in property <length> room;
    in property <bool> wide;
    in property <int> selected;

    alignment: start;
    spacing: Metrics.review-spacing;

    if root.wide: HorizontalLayout {
        spacing: Metrics.rail-gap;

        MoneyFacts {
            width: Metrics.rail-width;
            stacked: false;
            leaving: root.leaving;
            paying: root.paying;
            returning: root.returning;
            inputs: root.inputs;
            input-total: root.input-total;
            fee: root.fee;
            fee-sat: root.fee-sat;
            fee-rate: root.fee-rate;
            fee-percent: root.fee-percent;
            warning: root.warning;
        }

        Outputs {
            outputs: root.outputs;
            room: root.room;
            selected: root.selected;
        }
    }

    if !root.wide: MoneyFacts {
        stacked: true;
        leaving: root.leaving;
        paying: root.paying;
        returning: root.returning;
        inputs: root.inputs;
        input-total: root.input-total;
        fee: root.fee;
        fee-sat: root.fee-sat;
        fee-rate: root.fee-rate;
        fee-percent: root.fee-percent;
        warning: root.warning;
    }

    if !root.wide: Outputs {
        outputs: root.outputs;
        room: root.room;
        selected: root.selected;
    }
}

// 04-screens.md §11.3. **One full-width screen per payment address**, and the only structure
// that guarantees the address was alone on screen at the moment of approval — destination
// substitution is the attack this whole screen exists to catch.
//
// **The warning is absent here.** These screens exist for one job, and a fee statement on them
// dilutes exactly the property they were bought for. There is no other number on them either
// beyond the one this output pays.
component AddressScreen inherits Rectangle {
    in property <string> heading;
    in property <string> amount;
    in property <[string]> groups;
    in property <length> room;
    in property <bool> last;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        Heading {
            text: root.heading;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;

            Text {
                text: root.amount;
                color: Palette.ink;
                font-family: "DejaVu Sans Mono";
                font-size: 20px;
                vertical-alignment: center;
            }

            Text {
                text: "BTC";
                color: Palette.ink-dim;
                font-size: 14px;
                vertical-alignment: center;
            }
        }

        // §0: the wrapping treatment remains at §11.3's larger type, where a 22 px address
        // exceeds any canvas we ship. Wrapped in the same 4-character groups, never truncated.
        AddressBlock {
            groups: root.groups;
            size: Metrics.walk-address-size;
            room: root.room;
        }

        Choice {
            label: root.last ? "This is the address I mean" : "This is the address I mean — show the next one";
            note: "Escape returns to the review panel.";
            current: root.selected == 0;
        }
    }
}

// 04-screens.md §11.4's gate. **Signing is hold-to-confirm; refusing is a single press.** The
// asymmetry is the whole design: the irreversible action costs more than the safe one, and refusal
// is always reachable without hunting.
//
// **This component is byte-identical with and without the warning, structurally.** It has no
// property that could carry one — not an unused one, none — so there is nothing here for a fee, a
// ratio or an advisory to reach. Lengthening the hold when the warning fires would convert an
// advisory into a soft block, punish the user who is legitimately paying a high fee, and teach that
// hold duration carries meaning. The amounts are absent for the reason §11.5's are: the review was
// the moment of truth and this screen is the commitment to it.
//
// `progress` is 0..1, driven by the frame's own clock while the key is down. It is a bar and not a
// countdown: a number ticking down invites watching the number instead of deciding.
component GateScreen inherits Rectangle {
    in property <int> selected;
    in property <float> progress;

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        Heading {
            text: "Sign this transaction?";
        }

        Text {
            text: "Nothing has been signed yet. Holding produces the signature; a single press does not.";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        // The hold row. It is a `Choice` in everything but the fill, and the fill is drawn
        // *inside* it so the row's height does not change as the hold advances — a row that grew
        // would move the refusal underneath it while the user was committing.
        Rectangle {
            height: 66px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.selected == 0 ? Palette.focus : Palette.line-soft;
            background: root.selected == 0 ? Palette.ground : Palette.panel;
            clip: true;

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                alignment: center;
                spacing: 6px;

                Text {
                    text: "Hold Enter to sign";
                    color: Palette.ink;
                    font-size: 19px;
                    font-weight: root.selected == 0 ? 600 : 400;
                }

                // Zero-width at rest rather than hidden, so the bar's track is the same shape
                // whether or not a hold is in progress.
                Rectangle {
                    height: Metrics.hold-bar;
                    border-radius: Metrics.hold-bar / 2;
                    background: Palette.line-soft;

                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Palette.focus;
                    }
                }
            }
        }

        Choice {
            label: "Do not sign";
            note: "The transaction is discarded. Escape does the same.";
            current: root.selected == 1;
        }
    }
}

// 04-screens.md §11.5's outbound QR. **The title, the symbol and a static part count, and nothing
// else.**
//
// **No repeat of the amounts**: the review was the moment of truth, and restating money facts
// afterwards invites verification at the one moment when nothing can be changed. **No counter and
// no percentage**: BC-UR is rateless, so looping properly means generating fresh parts —
// *"part 3 of 4"* becomes a lie on the second pass and any percentage would describe our animation
// rather than their reception. The symbol's own flicker carries liveness.
//
// **One "done" and no second exit.** There is no *sign another*: that action lives on the identity
// screen one keystroke away, and a second control here is a second thing to press by accident at
// the moment the user should be holding the device still.
component OutboundScreen inherits Rectangle {
    in property <image> qr;
    in property <string> parts;
    in property <length> side;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: Metrics.outbound-spacing;

        Heading {
            text: "Signed. Show this to your wallet.";
        }

        // The symbol, on its own white ground with the quiet zone as padding. `pixelated` is
        // load-bearing rather than a preference: the image is one pixel per module, so a smoothing
        // filter would blur the module edges a scanner is looking for.
        Rectangle {
            width: root.side;
            height: root.side;
            background: #ffffff;
            border-width: 1px;
            border-color: Palette.line-soft;

            Image {
                source: root.qr;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }

        Text {
            text: root.parts;
            visible: root.parts != "";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        Choice {
            label: "Done";
            note: "Returns to the wallet screen. This transaction stays available there.";
            current: root.selected == 0;
        }
    }
}

// 02-core.md §7's refusal, as the screen it ends on: **the specific reason in plain language, a
// stable machine-readable code alongside it, and exactly one action — discard.**
//
// No *proceed anyway*, not behind a confirmation and not in an advanced menu. Both strings are
// computed in core, which is where the refusal is (standing rule 4); this file adds no sentence
// of its own, because a second copy of a refusal's copy is a second copy that can drift.
component RefusedScreen inherits Rectangle {
    in property <string> reason;
    in property <string> code;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        Heading {
            text: "This transaction was refused.";
        }

        Rectangle {
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.crit;
            background: Palette.panel;

            HorizontalLayout {
                padding: 16px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: root.reason;
                        color: Palette.ink;
                        font-size: 17px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.code;
                        color: Palette.crit;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                    }
                }
            }
        }

        Choice {
            label: "Discard";
            note: "Nothing was signed. The transaction is gone.";
            current: root.selected == 0;
        }
    }
}

// The honest placeholder. It exists so that choosing a real entry is not a dead press while
// the screens behind it are still being built (#75, #84, #85).
component Unbuilt inherits Rectangle {
    VerticalLayout {
        alignment: start;
        spacing: 14px;

        Heading {
            text: "Not in this build.";
        }

        Text {
            text: "That screen is not built yet. Nothing has changed, and nothing was signed.";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: "Press Escape to go back.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

// 04-screens.md §13. *End the session* and *shut down* are the same action, and restart is
// offered alongside it, labelled as what it actually delivers: a different wallet, from a
// fresh process with a fresh OnceLock (ADR-0010, ADR-0017) — not the machine's word for it.
//
// One press confirms, never a hold: an accidental shutdown mid-review is the most expensive
// accident in the product, and one press is the cheapest guard proportional to it.
component Ending inherits Rectangle {
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 22px;

        Heading {
            text: "End the session?";
        }

        VerticalLayout {
            spacing: 10px;

            Choice {
                label: "Shut down";
                note: "The machine powers off. Nothing on it is saved.";
                current: root.selected == 0;
            }

            Choice {
                label: "Start over with a different wallet";
                note: "aobs comes back in about a second with nothing loaded. The machine stays on.";
                current: root.selected == 1;
            }
        }

        Text {
            text: "Press Escape to go back.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <string> build-date;
    // Probed at the point of use rather than cached at startup (01-boot-layer.md §7), so a
    // camera plugged in later simply works.
    in property <bool> camera-present;
    in property <Screen> screen: Screen.start;

    // The create path (04-screens.md §2, §3). `rolls` is a count and never the rolls
    // themselves: the buffer lives in Rust, where it is zeroized, and 02-core.md §3 forbids
    // this screen anything more than the count anyway.
    in property <int> rolls;
    in property <int> wait-seconds;
    in property <bool> entropy-ready;
    in property <[Word]> left-column;
    in property <[Word]> right-column;
    // The position §4's rejection marked on the phrase, 1-based, or 0 for none.
    in property <int> marked;

    // The retype (04-screens.md §4). Every one of these is *what the user typed*, computed in
    // Rust from core's entry state: the phrase itself never reaches this screen.
    in property <[Slot]> retype-left;
    in property <[Slot]> retype-right;
    in property <string> retype-note;
    in property <int> retype-settled;
    in property <bool> retype-done;

    // The load screen (04-screens.md §5). `passphrase` arrives already rendered — delimited,
    // and with every space drawn as a mark — because the rendering is §5.1's mitigation and
    // belongs in one testable place, not in a binding here. `network-testnet` is the selector's
    // state and is set from Rust so that *mainnet preselected* is one fact in one file.
    in property <bool> network-testnet;
    in property <string> passphrase;
    in property <int> passphrase-count;
    in property <string> passphrase-note;

    // The identity screen (§7). Four facts off the loaded wallet, and nothing derived here:
    // `wallet-testnet` is the *loaded* network, which is not `network-testnet` above — that one
    // is what the selector was showing before the load, and after it the two can never disagree
    // because the passphrase and the network cannot change mid-session (02-core.md §12).
    in property <string> fingerprint;
    in property <bool> wallet-testnet;
    in property <bool> passphrase-in-use;
    in property <[Account]> accounts;

    // The scanning screen (§11.1). `scan-heading` and `scan-multi-part` are the configuration
    // and both are read off the payload class in core; `scan-note` and `scan-code` arrive
    // already written, because a refusal's sentence is computed where the refusal is
    // (standing rule 4). `scan-preview` is the luma plane, subsampled — never a frame this
    // file did anything to.
    in property <string> scan-heading;
    in property <image> scan-preview;
    in property <string> scan-progress;
    in property <bool> scan-multi-part;
    in property <string> scan-note;
    in property <string> scan-code;
    in property <bool> scan-stopped;

    // The review panel (§11.2) and §11.3's walk. **Every string here arrives already written**
    // — `format.rs` wrote the digits, `format::address_groups` did the 4-character split, core
    // wrote the refusal's sentence, and `review.rs` turned the one typed warning variant into
    // the one sentence. Nothing in this file formats an amount, splits an address or tests a
    // condition (standing rule 4, 02-core.md §9).
    //
    // `review-percent` and `review-warning` are empty when the fact does not exist: a
    // consolidation has no ratio and most transactions trip no warning, and §11.2.1 makes both
    // absences typed in core rather than rendered as a zero or a dash.
    in property <string> review-leaving;
    in property <string> review-paying;
    in property <string> review-returning;
    in property <string> review-inputs;
    in property <string> review-input-total;
    in property <string> review-fee;
    in property <[string]> review-fee-sat;
    in property <string> review-fee-rate;
    in property <string> review-fee-percent;
    in property <string> review-warning;
    in property <[Output]> review-outputs;
    in property <string> address-heading;
    in property <string> address-amount;
    in property <[string]> address-groups;
    in property <bool> address-last;
    // 02-core.md §7's two halves, both computed in core.
    in property <string> refusal-reason;
    in property <string> refusal-code;

    // §11.5's outbound animation. `outbound-qr` is one pixel per QR module, built in `outbound.rs`
    // from the matrix `aobs-core::outbound` computed — this file scales it and draws no module of
    // its own. `outbound-parts` is the **static** sentence, empty in the single-part case, because
    // §11.5 says *nothing at all* there and an absence is what typed emptiness looks like once it
    // reaches a layout.
    in property <image> outbound-qr;
    in property <string> outbound-parts;
    in property <length> outbound-room;
    // §7's fifth row, which **appears** rather than greying: the re-display action exists once a
    // transaction has been signed this session, and there is no state for it to be in before that
    // (02-core.md §12 — one slot, overwritten, no list).
    in property <bool> signed-available;

    // How much width an address has to lay itself out in, at each of the two places one is
    // drawn at full width. Handed in from `display::room` rather than read off an element's
    // own width: the address block's *height* is a function of this, and a layout whose
    // constraint is derived from the width it produces is what Slint reports as a binding loop.
    // It is also what makes the number the panel wraps against the same number `AOBS_REVIEW`
    // asserts (05-testing-and-release.md §6.2).
    in property <length> review-room;
    in property <length> walk-room;

    // The measuring instrument behind that assertion, and it is deliberately **the component
    // that draws**: `AddressBlock` measures one 4-character group in the face and size it
    // renders in, so `AOBS_REVIEW` reports what this font does on this machine rather than a
    // metric copied out of a font table. Zero-sized and clipped rather than hidden, so it is
    // laid out by exactly the code path a real address goes through.
    //
    // It carries no groups: `group-width` is a property of the ruler inside it, not of the
    // address handed to it.
    Rectangle {
        width: 0px;
        height: 0px;
        clip: true;

        gauge := AddressBlock {
            size: Metrics.address-size;
            room: 0px;
        }
    }

    out property <length> address-cell: gauge.group-width / 4;
    out property <length> address-gap: gauge.gap;

    callback intent(Intent);
    // The callbacks that carry a value rather than an intent, and so bypass the router
    // (standing rule 4): a die face is a byte the user typed, a letter of the retype is one
    // too, and `gathered` is the entropy thread announcing itself from
    // `upgrade_in_event_loop`. **None of them carries a decision** — `typed` hands a keystroke
    // to core's wordlist, which is the only thing that knows whether it lands.
    callback roll(int);
    callback gathered();
    callback typed(string);
    callback entry-back();
    callback entry-step(int);
    // The load screen's three, for the same reason: a character of the passphrase is a byte the
    // user typed, and **a network selection is a value too** — `04-screens.md` §5.2's selector is
    // a parameter of derivation, not a destination, so it never crosses the router either.
    callback network(bool);
    callback passphrase-typed(string);
    callback passphrase-back();
    // The capture thread announcing itself from `upgrade_in_event_loop`, the same shape as
    // `gathered`. It carries nothing: the frame is in a slot and the symbols are in a channel,
    // and this exists only because a `Send` closure cannot hold an `Rc`.
    callback scan-tick();

    // 04-screens.md §0's second breakpoint, one property for the whole appliance. Handed in
    // from `display::wide`, which already owns §0's arithmetic and can be tested; deriving it
    // from `root.width` here makes the layout's constraints depend on the width they produce,
    // which Slint reports as a binding loop that may panic at runtime.
    in property <bool> wide;

    // The ring. Every screen's own rows, plus the one the frame appends (§7: *restart /
    // shut down*, always). A screen never numbers its own rows into the frame's ring, and
    // the frame never has to be told which row means what.
    property <int> screen-rows: root.screen == Screen.start ? 3
        : root.screen == Screen.ending ? 2
        : root.screen == Screen.dice ? 1
        : root.screen == Screen.words ? 1
        : root.screen == Screen.retype ? 1
        // §5.2's two-state selector, then §5.1's confirm.
        : root.screen == Screen.load ? 3
        // §7's four actions, and a fifth once a transaction has been signed. The *re-display the
        // most recently signed transaction* row is **absent** rather than greyed: before the
        // first signature there is no state for it to be in (02-core.md §12).
        : root.screen == Screen.identity ? (root.signed-available ? 5 : 4)
        // §11.1's *nothing else is reachable while the camera is up*, as arithmetic: no rows
        // while it is live, and one — the way off a screen that has stopped — once it is not.
        // A refusal that leaves the camera up therefore adds no row either, which is what
        // makes *the screen stays live* structural rather than remembered.
        : root.screen == Screen.scan ? (root.scan-stopped ? 1 : 0)
        // §11.2's one action, §11.3's one press, and §7's one action. Each of these screens
        // carries exactly one row, and on the refusal screen that is the whole of 02-core.md
        // §7's *exactly one action: discard* — there is no second row for this frame to grow a
        // *proceed anyway* into.
        : root.screen == Screen.review ? 1
        : root.screen == Screen.address ? 1
        : root.screen == Screen.refused ? 1
        // §11.4's two, and the asymmetry is not in the count: row 0 is a hold and row 1 is a
        // press. §11.5's one, which is the whole of that screen's ring — there is no second exit.
        : root.screen == Screen.gate ? 2
        : root.screen == Screen.outbound ? 1
        : 0;
    property <int> rows: root.screen-rows + 1;
    property <int> session-row: root.rows - 1;
    property <int> selected: 0;

    // §11.4's hold, as a number this frame draws and does not compute.
    //
    // **The clock is `gate.rs`'s, because it has to be wall clock.** Accumulating `hold-tick`
    // here was the first version and it was wrong: a tick that repaints this bar on the software
    // renderer does not land in 50 ms, so 3.5 s of held key reached 97% on the built ISO. Three
    // seconds means three seconds, which means an `Instant`, which the frame does not have.
    //
    // **The clock runs only while a key is down.** There is exactly one `KeyPressed` and one
    // `KeyReleased` per physical press on this backend — the linuxkms input path synthesises no
    // repeat — so *down* is what the release ends and there is nothing else to evidence it with. A
    // hold that completed without a release would mean a tap signed, which is the one failure this
    // gate exists to prevent, so every exit from the screen and every other key clears it.
    in property <float> hold-progress;
    callback hold-begin();
    callback hold-end();

    // A screen change resets the cursor. Without it a ring that just got shorter would keep
    // a selection off its end, and the first key would move from nowhere.
    //
    // It clears the hold too, which is what makes the clock's lifetime the gate's: an intent
    // dispatched from a screen that has moved on is a press nobody made.
    changed screen => {
        self.selected = 0;
        self.hold-end();
    }

    title: "aobs";
    background: Palette.panel;
    // fonts-dejavu is in the 22-package floor (01-boot-layer.md §2); naming it means the
    // appliance renders the same on every machine rather than taking fontconfig's pick.
    default-font-family: "DejaVu Sans";
    default-font-size: 15px;
    forward-focus: keys;

    // Whether a row can be chosen. Every unavailable row stays visible with its reason stated
    // and navigation steps past it, so the reason is readable and the press is never dead.
    //
    // The parentheses are load-bearing rather than decorative. If `?:` bound tighter than
    // `&&`, the unparenthesised form would read *start screen **and** (row 2 ? camera : yes)*,
    // which is false for every row on every other screen — and `move` would then double-hop
    // past *start over with a different wallet* on §13's confirm. Not a precedence anyone
    // should have to be sure of to read this.
    function available(row: int) -> bool {
        if (root.screen == Screen.start && row == 2) {
            return root.camera-present;
        }
        // 04-screens.md §2: entropy readiness *unlocks* Continue and nothing more. The screen
        // never advances on its own, because the user may still be rolling.
        if (root.screen == Screen.dice && row == 0) {
            return root.entropy-ready;
        }
        // §4's Done, unlocked by core's own count of settled slots and nothing else. Locked it
        // states how many words are in, which is the progress this screen reports — there is no
        // bar, and no green tick for a word that matched.
        if (root.screen == Screen.retype && row == 0) {
            return root.retype-done;
        }
        // §7: *sign a transaction* and *verify a receive address* both need the camera, and they
        // are **adjacent** — which is what forced the third link into `move` below.
        if (root.screen == Screen.identity && (row == 1 || row == 2)) {
            return root.camera-present;
        }
        return true;
    }

    function wrap(row: int) -> int {
        return Math.mod(row + root.rows, root.rows);
    }

    // One hop, then up to two more while the rows it lands on are unavailable. Slint's functions
    // have no loop, so the depth of this chain *is* the bound, and the bound is stated rather
    // than assumed: **no three adjacent unavailable rows.**
    //
    // Two adjacent ones exist as of 04-screens.md §7 — *sign a transaction* and *verify a
    // receive address* are both greyed with a stated reason on a machine with no camera — which
    // is why one extra step is no longer enough. A screen that ever greys three neighbours needs
    // another link here, and it will present as a cursor that lands on a row Enter refuses.
    function move(delta: int) {
        // Moving off the hold row abandons the hold. A cursor that left while the clock ran would
        // sign from a row the user is no longer on.
        self.hold-end();
        self.selected = self.available(self.wrap(root.selected + delta))
            ? self.wrap(root.selected + delta)
            : self.available(self.wrap(root.selected + 2 * delta))
                ? self.wrap(root.selected + 2 * delta)
                : self.wrap(root.selected + 3 * delta);
    }

    function activate() {
        // An unavailable row is not a destination. `move` steps past them, so this is only
        // reachable where one is *selected* — the dice screen, whose Continue starts locked
        // and stays selected while it is.
        if (!root.available(root.selected)) {
            return;
        }
        if (root.selected == root.session-row) {
            root.intent(Intent.session-end);
        } else if (root.screen == Screen.start) {
            root.intent(root.selected == 0 ? Intent.create
                : root.selected == 1 ? Intent.import
                : Intent.restore);
        } else if (root.screen == Screen.ending) {
            root.intent(root.selected == 0 ? Intent.shut-down : Intent.restart);
        } else if (root.screen == Screen.dice) {
            root.intent(Intent.create-continue);
        } else if (root.screen == Screen.words) {
            root.intent(Intent.create-confirm);
        } else if (root.screen == Screen.retype) {
            root.intent(Intent.create-done);
        } else if (root.screen == Screen.load) {
            // Rows 0 and 1 are §5.2's selector and they carry a *value*, so they go through the
            // value callback the dice and the retype use rather than through an intent (standing
            // rule 4). Row 2 is §5.1's confirm, whose label has already stated which of the two
            // things is about to happen.
            if (root.selected == 0) {
                root.network(false);
            } else if (root.selected == 1) {
                root.network(true);
            } else {
                root.intent(Intent.load-confirm);
            }
        } else if (root.screen == Screen.scan) {
            // The one row a stopped scan has, and it fires the same intent Escape does: the
            // router already knows what this screen came from, so there is nothing here to
            // decide about where *back* is.
            root.intent(Intent.cancel);
        } else if (root.screen == Screen.review) {
            root.intent(Intent.review-sign);
        } else if (root.screen == Screen.gate) {
            // Row 0 is the hold and never reaches here — `key-pressed` takes Return on this
            // screen before `activate` can see it. Row 1 is §11.4's single press to refuse, and it
            // is the same intent Escape fires: the router already knows a discard returns to the
            // hub, and a second path to it is a second path that can drift.
            root.intent(Intent.cancel);
        } else if (root.screen == Screen.outbound) {
            root.intent(Intent.outbound-done);
        } else if (root.screen == Screen.address) {
            // One intent for every screen of the walk. Which address this was is `review`'s
            // state, and *whether another follows* is its answer too — a frame that counted
            // them would be a second place that knows how many payments there are.
            root.intent(Intent.address-confirm);
        } else if (root.screen == Screen.refused) {
            // The same intent Escape fires, for the reason the stopped scan's row does: §7's
            // one action is *discard*, the router already knows where a discard goes, and a
            // second path to it is a second path that can drift.
            root.intent(Intent.cancel);
        } else if (root.screen == Screen.identity) {
            // Row 3 is §7's re-display when it exists, and *backup export* is the last row either
            // way — which is why this reads the flag rather than the count: a row that appears has
            // to shift the one below it, and the alternative is two tables of indices.
            root.intent(root.selected == 0 ? Intent.watch-only
                : root.selected == 1 ? Intent.sign
                : root.selected == 2 ? Intent.verify-address
                : (root.signed-available && root.selected == 3) ? Intent.redisplay
                : Intent.backup-export);
        }
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            // Four keys, and Tab is deliberately not among them. There is exactly one
            // `FocusScope` in this appliance, so Slint's focus traversal has nowhere to
            // travel and Tab is at best a second name for Down — and at worst, if traversal
            // ran ahead of this handler, the one key that could take focus off the only
            // element that reads the keyboard.
            // The dice, and the only keys in this appliance that carry a value. Read
            // before the ring's own keys because they share nothing with them: a digit is
            // never navigation (04-screens.md §2).
            if (root.screen == Screen.dice
                && event.text.to-float() >= 1 && event.text.to-float() <= 6) {
                root.roll(event.text.to-float());
                return EventResult.accept;
            }
            // The retype's two correction keys (02-core.md §4). Read before the ring's,
            // because Left/Right mean *word* and Backspace means *letter* here and neither
            // means anything to the ring — while Up/Down and Enter below keep working on this
            // screen exactly as they do on every other.
            if (root.screen == Screen.retype && event.text == Key.LeftArrow) {
                root.entry-step(-1);
                return EventResult.accept;
            }
            if (root.screen == Screen.retype && event.text == Key.RightArrow) {
                root.entry-step(1);
                return EventResult.accept;
            }
            if (root.screen == Screen.retype && event.text == Key.Backspace) {
                root.entry-back();
                return EventResult.accept;
            }
            // The passphrase field's one correction key (04-screens.md §5.1). Read before the
            // ring's for the reason the retype's are: Backspace means *character* here and means
            // nothing to the ring, while Up/Down and Enter below keep working on this screen
            // exactly as they do on every other.
            if (root.screen == Screen.load && event.text == Key.Backspace) {
                root.passphrase-back();
                return EventResult.accept;
            }
            // §11.4's gate, read before the ring's Enter because on this screen Return means
            // *start holding* and not *activate*. Only on row 0: rows 1 and the session row are
            // ordinary presses, and `activate` is what they go through.
            //
            // `hold-begin` is idempotent while a hold runs (`gate.rs`), so a key repeat — which
            // this backend does not synthesise today, and which is exactly the kind of thing a
            // backend starts doing — restarts nothing and extends nothing.
            if (root.screen == Screen.gate && event.text == Key.Return && root.selected == 0) {
                root.hold-begin();
                return EventResult.accept;
            }
            if (event.text == Key.UpArrow) {
                root.move(-1);
                return EventResult.accept;
            }
            if (event.text == Key.DownArrow) {
                root.move(1);
                return EventResult.accept;
            }
            if (event.text == Key.Return) {
                root.activate();
                return EventResult.accept;
            }
            // Escape cancels wherever a cancel exists (§0). Whether one exists is the
            // router's answer, not this frame's: it knows what it would go back to.
            if (event.text == Key.Escape) {
                root.intent(Intent.cancel);
                return EventResult.accept;
            }
            // Everything else on the retype is a letter or the space bar, handed over as it
            // arrived. **The shell decides nothing about it**: core owns the wordlist, so what
            // lands and what is refused is one function in one place, and the key that did not
            // land is named from the outcome core returns (02-core.md §4, behaviour 3).
            if (root.screen == Screen.retype) {
                root.typed(event.text);
                return EventResult.accept;
            }
            // And everything else on the load screen is a passphrase character, handed over as
            // it arrived — **including the space bar**, which is a character here and not a
            // commit: `"hunter2 "` and `"hunter2"` are different wallets (02-core.md §5). The
            // shell decides nothing about it either: `load.rs` owns §5.1's printable-ASCII range
            // in one place, and the key that did not land is named from there.
            if (root.screen == Screen.load) {
                root.passphrase-typed(event.text);
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        // The other half of §11.4's hold, and the only reason this callback exists at all.
        //
        // **Releasing early is a cancel and not a signature**, which is what makes a tap safe: the
        // clock is cleared here and the intent is dispatched only by the clock reaching the
        // duration. Any release clears it, not only Return's — a modifier coming up mid-hold is
        // still a hand leaving the keyboard.
        key-released(event) => {
            root.hold-end();
            return EventResult.accept;
        }

        VerticalLayout {
            Rectangle {
                height: Metrics.header-height;
                background: Palette.ground;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: space-between;

                    Text {
                        text: "AOBS";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        letter-spacing: 1.7px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Up / Down to move        Enter to choose";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: Metrics.rule;
                background: Palette.line-soft;
            }

            // The screen slot. The frame's own padding is the one thing that reflows at the
            // breakpoint today; §11.2's rail arrives with the review panel and reads `wide`
            // from here rather than deriving it again.
            Rectangle {
                background: Palette.panel;

                HorizontalLayout {
                    padding: root.wide ? Metrics.slot-padding-wide : Metrics.slot-padding;

                    if root.screen == Screen.start: StartMenu {
                        camera: root.camera-present;
                        selected: root.selected;
                    }

                    if root.screen == Screen.dice: DiceScreen {
                        rolls: root.rolls;
                        wait-seconds: root.wait-seconds;
                        ready: root.entropy-ready;
                        selected: root.selected;
                    }

                    if root.screen == Screen.words: Words {
                        left: root.left-column;
                        right: root.right-column;
                        marked: root.marked;
                        selected: root.selected;
                    }

                    if root.screen == Screen.retype: RetypeScreen {
                        left: root.retype-left;
                        right: root.retype-right;
                        note: root.retype-note;
                        settled: root.retype-settled;
                        done: root.retype-done;
                        selected: root.selected;
                    }

                    if root.screen == Screen.load: LoadScreen {
                        testnet: root.network-testnet;
                        passphrase: root.passphrase;
                        count: root.passphrase-count;
                        note: root.passphrase-note;
                        selected: root.selected;
                    }

                    if root.screen == Screen.identity: IdentityScreen {
                        fingerprint: root.fingerprint;
                        testnet: root.wallet-testnet;
                        passphrase-in-use: root.passphrase-in-use;
                        accounts: root.accounts;
                        camera: root.camera-present;
                        signed: root.signed-available;
                        selected: root.selected;
                    }

                    if root.screen == Screen.scan: ScanScreen {
                        heading: root.scan-heading;
                        preview: root.scan-preview;
                        progress: root.scan-progress;
                        multi-part: root.scan-multi-part;
                        note: root.scan-note;
                        code: root.scan-code;
                        stopped: root.scan-stopped;
                        selected: root.selected;
                    }

                    if root.screen == Screen.review: ReviewPanel {
                        leaving: root.review-leaving;
                        paying: root.review-paying;
                        returning: root.review-returning;
                        inputs: root.review-inputs;
                        input-total: root.review-input-total;
                        fee: root.review-fee;
                        fee-sat: root.review-fee-sat;
                        fee-rate: root.review-fee-rate;
                        fee-percent: root.review-fee-percent;
                        warning: root.review-warning;
                        outputs: root.review-outputs;
                        room: root.review-room;
                        wide: root.wide;
                        selected: root.selected;
                    }

                    if root.screen == Screen.address: AddressScreen {
                        heading: root.address-heading;
                        amount: root.address-amount;
                        groups: root.address-groups;
                        room: root.walk-room;
                        last: root.address-last;
                        selected: root.selected;
                    }

                    if root.screen == Screen.gate: GateScreen {
                        progress: root.hold-progress;
                        selected: root.selected;
                    }

                    if root.screen == Screen.outbound: OutboundScreen {
                        qr: root.outbound-qr;
                        parts: root.outbound-parts;
                        side: root.outbound-room;
                        selected: root.selected;
                    }

                    if root.screen == Screen.refused: RefusedScreen {
                        reason: root.refusal-reason;
                        code: root.refusal-code;
                        selected: root.selected;
                    }

                    if root.screen == Screen.unbuilt: Unbuilt { }

                    if root.screen == Screen.ending: Ending {
                        selected: root.selected;
                    }
                }
            }

            Rectangle {
                height: Metrics.rule;
                background: Palette.line-soft;
            }

            // The footer carries the appended row, so *restart / shut down* is on screen and
            // in the ring on every screen there will ever be (04-screens.md §7, §13). The
            // physical power button lands on the same confirm this row does (ADR-0017).
            Rectangle {
                height: Metrics.footer-height;
                background: Palette.ground;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    alignment: space-between;

                    Rectangle {
                        width: 260px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.selected == root.session-row ? Palette.focus : Palette.ground;
                        background: root.selected == root.session-row ? Palette.panel : Palette.ground;

                        Text {
                            text: "Restart or shut down";
                            color: Palette.ink-mid;
                            font-size: 14px;
                            font-weight: root.selected == root.session-row ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // §10: the version and the build date make no security claim, and they
                    // are the one thing on this appliance a bug report can quote.
                    Text {
                        text: "version " + root.version + "    build " + root.build-date;
                        color: Palette.ink-dim;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
