// The shell frame: chrome, the keyboard, and the screens hung off it (#69).
//
// Light, one scheme throughout, no toggle (ADR-0011) — the palette below is the
// prototype's, which ADR-0011 calls a starting point rather than a mandate. There is no
// dark token set and no theme switch: **absent, not defaulted off.**
//
// Three rules from 04-screens.md §0 are structural here rather than per screen, which is
// the whole point of there being a frame:
//
//   * **Chrome does not vanish for any screen.** The header and the footer are outside the
//     screen slot, so no screen can remove them — including the ones that will show secret
//     material, where a disappearing frame would be a surprise on the screen demanding the
//     most attention.
//   * **Keyboard only, no pointer.** The software renderer draws no cursor and nothing here
//     has a `TouchArea`. One `FocusScope` in the frame owns every key, so navigation cannot
//     be reimplemented — or forgotten — screen by screen. Escape cancels wherever a cancel
//     exists, which the router decides by having somewhere to go back to.
//   * **The two breakpoints, and no third.** `wide` is computed once, from the logical
//     width the scale factor produced (04-screens.md §0, §11.2: the threshold is the design
//     width). The review panel is its first real consumer — a fixed rail beside the outputs
//     above it, stacked above them below it — and it reads this rather than deriving its own.
//
// The frame also **appends one row to every screen**: 04-screens.md §7 lists *restart /
// shut down* as always available, and a screen that had to add it itself is a screen that
// can forget it. It is the last row of the ring on every screen, reachable from all of them
// with the same two keys as everything else.

// What the user asked for. The frame names the intent; the router decides where it lands
// (04-screens.md: the shell decides nothing about money and branches on no validation
// outcome, and one callback carrying an intent is what keeps that checkable).
export enum Intent {
    create,
    create-continue,
    create-confirm,
    create-done,
    import,
    restore,
    session-end,
    shut-down,
    restart,
    cancel,
}

// Which screen is in the slot. `unbuilt` is honest rather than permanent: the three start
// entries route somewhere real in later slices, and until then the frame says so instead of
// swallowing the press (standing rule 8).
export enum Screen {
    start,
    dice,
    words,
    retype,
    unbuilt,
    ending,
}

// One numbered word of the phrase. The *position* travels with the text rather than being
// the index of a row, because 04-screens.md §3's fill is column-major: the thirteenth word
// is the first row of the right-hand column, and a component that numbered its own rows
// would have to be told which column it is.
export struct Word {
    position: int,
    text: string,
}

// One slot of the retype (04-screens.md §4). `text` is what the *user* typed — the committed
// word, or the letters going into the slot they are on — and never the phrase: the answer is
// in core, behind no accessor at all. `ghost` is the rest of the single remaining word, drawn
// dim inline after the buffer, which is the one completion this component offers (02-core.md
// §4's fifth behaviour: it finishes the word being typed and proposes none).
export struct Slot {
    position: int,
    text: string,
    ghost: string,
    current: bool,
}

// The numbers the frame lays itself out with, in one place because one of them is an owed
// measurement (00-overview.md, 04-screens.md §3): *that two columns of 12 words fit the
// 800×600 minimum canvas at the settled type size*. The shell reads `words-required` and
// `words-chrome` off this global at startup and prints both against the canvas it learned,
// so the claim is checked on every boot rather than measured once in a browser frame.
export global Metrics {
    out property <length> header-height: 44px;
    out property <length> footer-height: 48px;
    out property <length> rule: 1px;
    // The screen slot's padding at each breakpoint (04-screens.md §0). The floor is the
    // narrow one, which is why that is the value the measurement below is taken against.
    out property <length> slot-padding: 24px;
    out property <length> slot-padding-wide: 44px;

    // The words screen, as the heights it is actually built from.
    out property <length> word-row: 26px;
    out property <length> words-banner: 52px;
    out property <length> words-gap: 14px;
    out property <length> words-continue: 48px;
    out property <length> words-required: root.words-banner + root.words-gap
        + 12 * root.word-row + root.words-gap + root.words-continue;
    out property <length> words-chrome: root.header-height + 2 * root.rule + root.footer-height
        + 2 * root.slot-padding;
}

export global Palette {
    out property <color> ground: #eef1f5;
    out property <color> panel: #ffffff;
    out property <color> line-soft: #dfe5ec;
    out property <color> ink: #0f151c;
    out property <color> ink-mid: #414d5c;
    out property <color> ink-dim: #66717f;
    // §0: darkened from the dark scheme's value to hold contrast against a white panel.
    out property <color> focus: #14468f;
}

// One row of a ring. `note` carries the stated reason when a row is unavailable — 01-boot
// -layer.md §7 and 04-screens.md §1 both require *visibly unavailable with the reason
// stated*, never hidden — and a plain sub-line otherwise.
component Choice inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> available: true;
    in property <bool> current: false;

    height: 66px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.current ? Palette.focus : Palette.line-soft;
    background: root.current ? Palette.ground : Palette.panel;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.label;
                color: root.available ? Palette.ink : Palette.ink-dim;
                font-size: 19px;
                font-weight: root.current ? 600 : 400;
            }

            Text {
                text: root.note;
                visible: root.note != "";
                color: Palette.ink-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

component Heading inherits Text {
    color: Palette.ink;
    font-size: 26px;
    font-weight: 600;
}

// 04-screens.md §1. A flat three-entry menu, labelled by the input the user is holding —
// paper with words, or a QR — because labelling by artifact fails: the encrypted QR is a
// re-encoding of the mnemonic, so "backup" names both artifacts. No submenu, and no way
// back here later: this is a boot-time menu, not a mode switch (ADR-0010).
component StartMenu inherits Rectangle {
    in property <bool> camera;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 22px;

        Heading {
            text: "What are you holding?";
        }

        VerticalLayout {
            spacing: 10px;

            Choice {
                label: "Create a new wallet";
                note: "24 words, generated here, on paper before anything else happens.";
                current: root.selected == 0;
            }

            Choice {
                label: "Type a seed phrase";
                note: "You have the words on paper.";
                current: root.selected == 1;
            }

            Choice {
                label: "Scan an encrypted backup";
                // Not hidden, and the reason is on screen rather than in a manual.
                note: root.camera
                    ? "You have the QR this appliance printed for you, and the eight words that unlock it."
                    : "Unavailable: no camera was found. Plug in a USB webcam and start over, or type the words instead.";
                available: root.camera;
                current: root.selected == 2;
            }
        }

        Text {
            text: "One wallet per boot. There is no way back to this menu.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

// 04-screens.md §2. **One screen doing both jobs**: the rolls are needed before the mnemonic
// exists, which is exactly when `getrandom(2)` is still blocking, so the dead time carries
// the optional feature at the cost of no extra step — and a screen with something to do on
// it cannot read as a hang.
//
// What is *not* here is the specification (02-core.md §3): no minimum, no bit counter, no
// progress meter, no distribution check, and **no running hash of the rolls**. The roll
// count is the whole of what this screen says about them, because the rolls are mixed rather
// than substituted and a hash on screen would hand back the property that makes that safe.
//
// The wait is indeterminate with elapsed seconds and no percentage, and it **only unlocks
// Continue**: nothing here advances on its own, because the user may still be rolling.
component DiceScreen inherits Rectangle {
    in property <int> rolls;
    in property <int> wait-seconds;
    in property <bool> ready;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 16px;

        Heading {
            text: "Dice, if you want them";
        }

        // The mandated line of copy, on the screen where it will actually be read.
        Text {
            text: "Your rolls are combined with the system random number generator. "
                + "They can only add randomness, never remove it.";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: "Type your rolls as digits, 1 to 6. Stop whenever you like.";
            color: Palette.ink-dim;
            font-size: 13px;
            wrap: word-wrap;
        }

        // The count, and nothing else. Zero is stated as an answer rather than as an empty
        // field, because it is one: with no supplement the entropy is `getrandom`'s bytes
        // verbatim, and nothing about this screen is a requirement (02-core.md §3).
        Text {
            text: root.rolls == 0
                ? "nothing rolled yet — that is a complete answer"
                : "rolls: " + root.rolls;
            color: root.rolls == 0 ? Palette.ink-dim : Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: 20px;
        }

        Choice {
            label: "Continue";
            // The wait, stated as what it is. Seconds because they are known; no bar,
            // because `getrandom(2)` reports no progress and a fabricated one stalling near
            // the end reads more like a hang than a spinner does (04-screens.md §2).
            note: root.ready
                ? "The system random number generator is ready."
                : "Waiting for the system random number generator — " + root.wait-seconds + " s. "
                    + "Keep rolling, or wait.";
            available: root.ready;
            current: root.selected == 0;
        }
    }
}

// One numbered word. The row height is Metrics' and not this component's, because it is a
// term in the owed measurement above.
component WordRow inherits Rectangle {
    in property <Word> word;
    // 04-screens.md §4: a wrong word in the retype returns here with its position marked for
    // repair. The mark is on the row rather than in the copy because the copy already names
    // the number, and what the user needs next is to find that line on the paper.
    in property <bool> marked;

    height: Metrics.word-row;
    border-radius: 3px;
    background: root.marked ? Palette.ground : transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.word.position;
            width: 28px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.marked ? Palette.focus : Palette.ink-dim;
            font-family: "DejaVu Sans Mono";
            font-size: 14px;
        }

        Text {
            text: root.word.text;
            vertical-alignment: center;
            color: Palette.ink;
            font-family: "DejaVu Sans Mono";
            font-size: 17px;
        }
    }
}

// 04-screens.md §3. **Two column-major columns of 12 — 1–12 left, 13–24 right, all visible
// at once.** The fill is the argument: a column of twelve is the shape of the card or steel
// plate being copied onto, so screen and destination share a geometry and the copy becomes
// positional rather than sequential. A row-flow grid renders 1,2 / 3,4 and inverts it, which
// is why the two columns arrive as two models built and tested in Rust rather than as one
// list this file slices.
//
// **No pages.** A page turn sits exactly where a place gets lost during transcription, and it
// makes cross-checking impossible when half the phrase is never on screen with the other half.
component Words inherits Rectangle {
    in property <[Word]> left;
    in property <[Word]> right;
    // The position the retype rejected, 1-based, or 0 when the phrase is simply being
    // written down for the first time.
    in property <int> marked;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: Metrics.words-gap;

        // The instructional banner. It stays because it carries information, and its height
        // is fixed because it is a term in the measurement.
        VerticalLayout {
            height: Metrics.words-banner;
            spacing: 6px;

            Text {
                // The repair copy names the position, because naming the position *is* the
                // repair (04-screens.md §4) — and it names both possibilities, because the
                // appliance knows a word came back different and not which side was wrong.
                text: root.marked == 0
                    ? "Write these 24 words on paper, in this order."
                    : "What you typed for word " + root.marked + " is not word " + root.marked + ".";
                color: Palette.ink;
                font-size: 20px;
                font-weight: 600;
            }

            Text {
                text: root.marked == 0
                    ? "They are the only copy. Anyone who has them has the wallet, and nothing here is stored."
                    : "Check that line against your paper, fix whichever is wrong, and carry on. Nothing you typed is lost.";
                color: Palette.ink-mid;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 28px;

            VerticalLayout {
                for word in root.left: WordRow {
                    word: word;
                    marked: word.position == root.marked;
                }
            }

            VerticalLayout {
                for word in root.right: WordRow {
                    word: word;
                    marked: word.position == root.marked;
                }
            }
        }

        Choice {
            height: Metrics.words-continue;
            // 04-screens.md §4 rejects a `restart` control by name: it voids everything
            // already written down and re-asks the same transcription of someone who has just
            // proved they can slip. So there is one row here on both visits, and on the second
            // it says what it does — carry on from where the rejection left off.
            label: root.marked == 0 ? "I have written them down" : "Carry on typing";
            current: root.selected == 0;
        }
    }
}

// One slot of the retype. The row height is Metrics' — the same 26 px the phrase is drawn at,
// because the two screens are the same twelve-and-twelve geometry and the sum that has to fit
// the 800×600 floor is one number for both (04-screens.md §3's measurement).
component SlotRow inherits Rectangle {
    in property <Slot> slot;

    height: Metrics.word-row;
    border-radius: 3px;
    background: root.slot.current ? Palette.ground : transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.slot.position;
            width: 28px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.slot.current ? Palette.focus : Palette.ink-dim;
            font-family: "DejaVu Sans Mono";
            font-size: 14px;
        }

        HorizontalLayout {
            alignment: start;
            // Explicit, because the buffer and its ghosted completion have to read as one
            // word: `abandon` typed as `aban` plus `don` cannot be `aban don`.
            spacing: 0px;

            Text {
                text: root.slot.text;
                vertical-alignment: center;
                color: Palette.ink;
                font-family: "DejaVu Sans Mono";
                font-size: 17px;
            }

            // The single remaining word, ghosted inline (04-screens.md §6). It completes the
            // word being typed and never proposes one — the appliance supplies no key material
            // the user did not (02-core.md §4, behaviour 5).
            Text {
                text: root.slot.ghost;
                vertical-alignment: center;
                color: Palette.ink-dim;
                font-family: "DejaVu Sans Mono";
                font-size: 17px;
            }

            // The caret: a 2 px rule rather than a glyph, so it needs no font coverage and
            // cannot be misread as a letter of the word being typed.
            Rectangle {
                width: 2px;
                background: Palette.focus;
                visible: root.slot.current;
            }
        }
    }
}

// 04-screens.md §4. **The full 24-word retype, typed from paper, with the phrase off screen.**
//
// The arithmetic is what settles it: against a single mis-copied word — the top loss mode, the
// one that surfaces years later — ticking *written down* detects 0% and a four-position sample
// detects 4/24. The full retype detects all of it, and buys the thing neither alternative can:
// the user rehearses the restore while the paper is still fresh enough to correct.
//
// **The reframe that decides everything on this screen: it is not a gate proving the phrase was
// written down, it is an instrument for making the paper correct — so a failure is the feature
// working.** Hence: committed words are echoed, because an off-by-one has to be visible as a
// *shift* rather than as a mystery rejection at word 20; nothing is masked; a rejection names
// the position and destroys nothing; and there is **no restart control** anywhere on it.
component RetypeScreen inherits Rectangle {
    in property <[Slot]> left;
    in property <[Slot]> right;
    in property <string> note;
    in property <int> settled;
    in property <bool> done;
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: Metrics.words-gap;

        VerticalLayout {
            height: Metrics.words-banner;
            spacing: 6px;

            Text {
                text: "Type the 24 words from your paper.";
                color: Palette.ink;
                font-size: 20px;
                font-weight: 600;
            }

            // The live line, and it sits *inside* the banner's fixed height rather than as a
            // row of its own: that height is a term in §3's measurement, and this screen is
            // built from the same numbers so the same sum covers both.
            Text {
                text: root.note;
                color: Palette.ink-mid;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 28px;

            VerticalLayout {
                for slot in root.left: SlotRow {
                    slot: slot;
                }
            }

            VerticalLayout {
                for slot in root.right: SlotRow {
                    slot: slot;
                }
            }
        }

        Choice {
            height: Metrics.words-continue;
            label: "Done";
            note: root.done
                ? "Press Enter to finish."
                : root.settled + " of 24 typed.";
            available: root.done;
            current: root.selected == 0;
        }
    }
}

// The honest placeholder. It exists so that choosing a real entry is not a dead press while
// the screens behind it are still being built (#73, #75, #85).
component Unbuilt inherits Rectangle {
    VerticalLayout {
        alignment: start;
        spacing: 14px;

        Heading {
            text: "Not in this build.";
        }

        Text {
            text: "That screen is not built yet. This appliance holds no wallet and signs nothing.";
            color: Palette.ink-mid;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: "Press Escape to go back.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

// 04-screens.md §13. *End the session* and *shut down* are the same action, and restart is
// offered alongside it, labelled as what it actually delivers: a different wallet, from a
// fresh process with a fresh OnceLock (ADR-0010, ADR-0017) — not the machine's word for it.
//
// One press confirms, never a hold: an accidental shutdown mid-review is the most expensive
// accident in the product, and one press is the cheapest guard proportional to it.
component Ending inherits Rectangle {
    in property <int> selected;

    VerticalLayout {
        alignment: start;
        spacing: 22px;

        Heading {
            text: "End the session?";
        }

        VerticalLayout {
            spacing: 10px;

            Choice {
                label: "Shut down";
                note: "The machine powers off. Nothing on it is saved.";
                current: root.selected == 0;
            }

            Choice {
                label: "Start over with a different wallet";
                note: "aobs comes back in about a second with nothing loaded. The machine stays on.";
                current: root.selected == 1;
            }
        }

        Text {
            text: "Press Escape to go back.";
            color: Palette.ink-dim;
            font-size: 13px;
        }
    }
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <string> build-date;
    // Probed at the point of use rather than cached at startup (01-boot-layer.md §7), so a
    // camera plugged in later simply works.
    in property <bool> camera-present;
    in property <Screen> screen: Screen.start;

    // The create path (04-screens.md §2, §3). `rolls` is a count and never the rolls
    // themselves: the buffer lives in Rust, where it is zeroized, and 02-core.md §3 forbids
    // this screen anything more than the count anyway.
    in property <int> rolls;
    in property <int> wait-seconds;
    in property <bool> entropy-ready;
    in property <[Word]> left-column;
    in property <[Word]> right-column;
    // The position §4's rejection marked on the phrase, 1-based, or 0 for none.
    in property <int> marked;

    // The retype (04-screens.md §4). Every one of these is *what the user typed*, computed in
    // Rust from core's entry state: the phrase itself never reaches this screen.
    in property <[Slot]> retype-left;
    in property <[Slot]> retype-right;
    in property <string> retype-note;
    in property <int> retype-settled;
    in property <bool> retype-done;

    callback intent(Intent);
    // The callbacks that carry a value rather than an intent, and so bypass the router
    // (standing rule 4): a die face is a byte the user typed, a letter of the retype is one
    // too, and `gathered` is the entropy thread announcing itself from
    // `upgrade_in_event_loop`. **None of them carries a decision** — `typed` hands a keystroke
    // to core's wordlist, which is the only thing that knows whether it lands.
    callback roll(int);
    callback gathered();
    callback typed(string);
    callback entry-back();
    callback entry-step(int);

    // 04-screens.md §0's second breakpoint, one property for the whole appliance. Handed in
    // from `display::wide`, which already owns §0's arithmetic and can be tested; deriving it
    // from `root.width` here makes the layout's constraints depend on the width they produce,
    // which Slint reports as a binding loop that may panic at runtime.
    in property <bool> wide;

    // The ring. Every screen's own rows, plus the one the frame appends (§7: *restart /
    // shut down*, always). A screen never numbers its own rows into the frame's ring, and
    // the frame never has to be told which row means what.
    property <int> screen-rows: root.screen == Screen.start ? 3
        : root.screen == Screen.ending ? 2
        : root.screen == Screen.dice ? 1
        : root.screen == Screen.words ? 1
        : root.screen == Screen.retype ? 1
        : 0;
    property <int> rows: root.screen-rows + 1;
    property <int> session-row: root.rows - 1;
    property <int> selected: 0;

    // A screen change resets the cursor. Without it a ring that just got shorter would keep
    // a selection off its end, and the first key would move from nowhere.
    changed screen => {
        self.selected = 0;
    }

    title: "aobs";
    background: Palette.panel;
    // fonts-dejavu is in the 22-package floor (01-boot-layer.md §2); naming it means the
    // appliance renders the same on every machine rather than taking fontconfig's pick.
    default-font-family: "DejaVu Sans";
    default-font-size: 15px;
    forward-focus: keys;

    // Whether a row can be chosen. The only unavailable row the appliance has today is the
    // one that needs a camera (04-screens.md §1); it stays visible and navigation steps past
    // it, so the reason is readable and the press is never dead.
    //
    // The parentheses are load-bearing rather than decorative. If `?:` bound tighter than
    // `&&`, the unparenthesised form would read *start screen **and** (row 2 ? camera : yes)*,
    // which is false for every row on every other screen — and `move` would then double-hop
    // past *start over with a different wallet* on §13's confirm. Not a precedence anyone
    // should have to be sure of to read this.
    function available(row: int) -> bool {
        if (root.screen == Screen.start && row == 2) {
            return root.camera-present;
        }
        // 04-screens.md §2: entropy readiness *unlocks* Continue and nothing more. The screen
        // never advances on its own, because the user may still be rolling.
        if (root.screen == Screen.dice && row == 0) {
            return root.entropy-ready;
        }
        // §4's Done, unlocked by core's own count of settled slots and nothing else. Locked it
        // states how many words are in, which is the progress this screen reports — there is no
        // bar, and no green tick for a word that matched.
        if (root.screen == Screen.retype && row == 0) {
            return root.retype-done;
        }
        return true;
    }

    function wrap(row: int) -> int {
        return Math.mod(row + root.rows, root.rows);
    }

    // One hop, then one more if the row it landed on is unavailable. A single extra step is
    // enough while no two unavailable rows are adjacent, which the one-unavailable-row rule
    // above guarantees — and it has to be, because Slint's functions have no loop. A screen
    // that ever greys two neighbouring rows needs this rewritten, not extended.
    function move(delta: int) {
        self.selected = self.available(self.wrap(root.selected + delta))
            ? self.wrap(root.selected + delta)
            : self.wrap(root.selected + 2 * delta);
    }

    function activate() {
        // An unavailable row is not a destination. `move` steps past them, so this is only
        // reachable where one is *selected* — the dice screen, whose Continue starts locked
        // and stays selected while it is.
        if (!root.available(root.selected)) {
            return;
        }
        if (root.selected == root.session-row) {
            root.intent(Intent.session-end);
        } else if (root.screen == Screen.start) {
            root.intent(root.selected == 0 ? Intent.create
                : root.selected == 1 ? Intent.import
                : Intent.restore);
        } else if (root.screen == Screen.ending) {
            root.intent(root.selected == 0 ? Intent.shut-down : Intent.restart);
        } else if (root.screen == Screen.dice) {
            root.intent(Intent.create-continue);
        } else if (root.screen == Screen.words) {
            root.intent(Intent.create-confirm);
        } else if (root.screen == Screen.retype) {
            root.intent(Intent.create-done);
        }
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            // Four keys, and Tab is deliberately not among them. There is exactly one
            // `FocusScope` in this appliance, so Slint's focus traversal has nowhere to
            // travel and Tab is at best a second name for Down — and at worst, if traversal
            // ran ahead of this handler, the one key that could take focus off the only
            // element that reads the keyboard.
            // The dice, and the only keys in this appliance that carry a value. Read
            // before the ring's own keys because they share nothing with them: a digit is
            // never navigation (04-screens.md §2).
            if (root.screen == Screen.dice
                && event.text.to-float() >= 1 && event.text.to-float() <= 6) {
                root.roll(event.text.to-float());
                return EventResult.accept;
            }
            // The retype's two correction keys (02-core.md §4). Read before the ring's,
            // because Left/Right mean *word* and Backspace means *letter* here and neither
            // means anything to the ring — while Up/Down and Enter below keep working on this
            // screen exactly as they do on every other.
            if (root.screen == Screen.retype && event.text == Key.LeftArrow) {
                root.entry-step(-1);
                return EventResult.accept;
            }
            if (root.screen == Screen.retype && event.text == Key.RightArrow) {
                root.entry-step(1);
                return EventResult.accept;
            }
            if (root.screen == Screen.retype && event.text == Key.Backspace) {
                root.entry-back();
                return EventResult.accept;
            }
            if (event.text == Key.UpArrow) {
                root.move(-1);
                return EventResult.accept;
            }
            if (event.text == Key.DownArrow) {
                root.move(1);
                return EventResult.accept;
            }
            if (event.text == Key.Return) {
                root.activate();
                return EventResult.accept;
            }
            // Escape cancels wherever a cancel exists (§0). Whether one exists is the
            // router's answer, not this frame's: it knows what it would go back to.
            if (event.text == Key.Escape) {
                root.intent(Intent.cancel);
                return EventResult.accept;
            }
            // Everything else on the retype is a letter or the space bar, handed over as it
            // arrived. **The shell decides nothing about it**: core owns the wordlist, so what
            // lands and what is refused is one function in one place, and the key that did not
            // land is named from the outcome core returns (02-core.md §4, behaviour 3).
            if (root.screen == Screen.retype) {
                root.typed(event.text);
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            Rectangle {
                height: Metrics.header-height;
                background: Palette.ground;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: space-between;

                    Text {
                        text: "AOBS";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        letter-spacing: 1.7px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Up / Down to move        Enter to choose";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: Metrics.rule;
                background: Palette.line-soft;
            }

            // The screen slot. The frame's own padding is the one thing that reflows at the
            // breakpoint today; §11.2's rail arrives with the review panel and reads `wide`
            // from here rather than deriving it again.
            Rectangle {
                background: Palette.panel;

                HorizontalLayout {
                    padding: root.wide ? Metrics.slot-padding-wide : Metrics.slot-padding;

                    if root.screen == Screen.start: StartMenu {
                        camera: root.camera-present;
                        selected: root.selected;
                    }

                    if root.screen == Screen.dice: DiceScreen {
                        rolls: root.rolls;
                        wait-seconds: root.wait-seconds;
                        ready: root.entropy-ready;
                        selected: root.selected;
                    }

                    if root.screen == Screen.words: Words {
                        left: root.left-column;
                        right: root.right-column;
                        marked: root.marked;
                        selected: root.selected;
                    }

                    if root.screen == Screen.retype: RetypeScreen {
                        left: root.retype-left;
                        right: root.retype-right;
                        note: root.retype-note;
                        settled: root.retype-settled;
                        done: root.retype-done;
                        selected: root.selected;
                    }

                    if root.screen == Screen.unbuilt: Unbuilt { }

                    if root.screen == Screen.ending: Ending {
                        selected: root.selected;
                    }
                }
            }

            Rectangle {
                height: Metrics.rule;
                background: Palette.line-soft;
            }

            // The footer carries the appended row, so *restart / shut down* is on screen and
            // in the ring on every screen there will ever be (04-screens.md §7, §13). The
            // physical power button lands on the same confirm this row does (ADR-0017).
            Rectangle {
                height: Metrics.footer-height;
                background: Palette.ground;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    alignment: space-between;

                    Rectangle {
                        width: 260px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.selected == root.session-row ? Palette.focus : Palette.ground;
                        background: root.selected == root.session-row ? Palette.panel : Palette.ground;

                        Text {
                            text: "Restart or shut down";
                            color: Palette.ink-mid;
                            font-size: 14px;
                            font-weight: root.selected == root.session-row ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // §10: the version and the build date make no security claim, and they
                    // are the one thing on this appliance a bug report can quote.
                    Text {
                        text: "version " + root.version + "    build " + root.build-date;
                        color: Palette.ink-dim;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
