#
# The appliance's kernel, as one reviewable file.
#
# `docs/boot-pipeline.md`: #10 and #14 both promise claims checkable *by reading the kernel config*
# — exactly two USB class drivers, no block driver, no networking. That is only true if the config
# is one file in this repository rather than a fragment merged into a distribution's config at
# build time, which is the decisive reason for vanilla kernel.org source over Alpine's `APKBUILD`.
#
# This file is a `.config` in Kbuild's own syntax and is applied as an **allnoconfig preset**:
#
#     KCONFIG_ALLCONFIG=build/kernel.config make allnoconfig
#
# so the base is "everything off" and nothing is enabled that is not asked for below. `# CONFIG_X
# is not set` lines are therefore redundant to the base and written anyway: a reader checking the
# no-network or no-block claim should find the claim stated, not have to infer it from an absence.
#
# `build/verify.py` reads this file and the generated `.config`, and `build/mkiso.sh` exits
# non-zero on the first violation. Every line marked *(claim)* below is asserted there, and
# `tests/test_build_verifier.py` breaks each one on purpose to prove the assertion still bites.
#
# What this file cannot prove is sufficiency: that the resulting kernel boots on real firmware,
# finds a framebuffer, and enumerates a camera. That is `docs/boot-checklist.md`'s half, and the
# boundary is deliberate.
#

# --- Architecture and the basics -----------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SYSCTL=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_SHMEM=y
CONFIG_MEMBARRIER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_PM=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# `CONFIG_COREDUMP=n` is `bool "Enable core dump support" if EXPERT`, so `EXPERT` is what makes the
# claim below reachable at all (`docs/secret-hygiene.md`).
CONFIG_EXPERT=y

# --- The whole system runs from the initramfs (#10) ----------------------------------------------
# *(claim)* After the kernel and initramfs load, the boot medium is never read again and can be
# pulled. There is no root device to find because there is no block layer to find one with.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# `find /rootfs | cpio -H newc | zstd` is the only initramfs format the build produces.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set

# --- No network stack (#2) -----------------------------------------------------------------------
# *(claim)* No network interface is ever brought up, because none can be: there is no networking
# in the kernel. This also removes `AF_UNIX`, and with it `multiprocessing` and anything
# socket-backed — which is why the build import-checks every module the app needs.
# CONFIG_NET is not set

# --- All built-in, no modloop (#10) --------------------------------------------------------------
# *(claim)* Nothing can be loaded into the running kernel. This is also what forecloses Alpine's
# `mkimage.sh` and `mkinitfs`, whose purpose is mounting a modloop squashfs of modules that do not
# exist here.
# CONFIG_MODULES is not set

# --- No block device, no storage driver, no swap -------------------------------------------------
# *(claim)* No block device is ever mounted, and no `/dev/sd*`, `/dev/sr*` or `/dev/loop*` node can
# exist, because no driver exists to create one. `CONFIG_BLOCK=n` removes the layer itself; the
# driver lines below are the same claim stated where a reader would look for it.
# CONFIG_BLOCK is not set
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_BLK_DEV is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_MD is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_XEN_BLKDEV_FRONTEND is not set
# CONFIG_ZRAM is not set
# CONFIG_NVDIMM_DEVICES is not set

# --- No filesystem is ever mounted: tmpfs and pseudo-filesystems only ---------------------------
# *(claim)* `/proc/mounts` on the running appliance lists only tmpfs, proc, sys, dev, devpts, shm.
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y
# CONFIG_EXT4_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FUSE_FS is not set

# --- Containment ---------------------------------------------------------------------------------
# *(claim)* The containment claim holds against a keyboard, and there is no path from the running
# app to another kernel or to a window onto memory.
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_BPF_SYSCALL is not set

# --- Secret hygiene ------------------------------------------------------------------------------
# *(claim)* No core dumper exists in the kernel to write derived key material out. The app also
# calls `setrlimit(RLIMIT_CORE, (0, 0))`, and that is belt-and-braces, never the claim: it is a
# userspace call made by the same code that would be failing.
# CONFIG_COREDUMP is not set
# *(claim)* A page CPython returns to the kernel does not retain a key. Bounded in
# `docs/secret-hygiene.md`: it does not cover reuse inside musl's allocator.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# --- Entropy (#8) --------------------------------------------------------------------------------
# *(claim)* RDRAND is never a sole or direct source of the entropy floor. Both of these default to
# *on* upstream; the cmdline says `random.trust_cpu=off random.trust_bootloader=off` as well, and
# this is the same claim in the file a reviewer reads.
# CONFIG_RANDOM_TRUST_CPU is not set
# CONFIG_RANDOM_TRUST_BOOTLOADER is not set

# --- Console: fbcon over firmware framebuffers only (#3) ----------------------------------------
# *(claim)* No DRM GPU driver is compiled in — they are large and several need firmware blobs, which
# an all-built-in no-modules kernel would have to carry and load. `efifb` covers UEFI, `vesafb`
# covers BIOS with `vga=791`, and 1024×768 is the resolution floor on both paths.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# The kernel's own 8×16 font satisfies #3's exact-1:2 cell requirement, which is why
# `font-terminus` (2.17 MiB) is not installed.
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
# CONFIG_DRM is not set
# CONFIG_VGA_CONSOLE is not set

# --- Input ---------------------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
# An offline machine kept for exactly this purpose is often old enough that its keyboard is PS/2,
# which reaches the console through `atkbd` rather than through `usbhid`.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
# CONFIG_INPUT_MOUSE is not set

# --- USB: exactly two class drivers (#14) -------------------------------------------------------
# *(claim)* The built-in USB class driver list is **exactly** `usbhid` and `uvcvideo`. The verifier
# checks this as an equality over every enabled symbol mentioning USB, not as a pair of greps —
# a pair of greps passes with a third driver present, which is what #14 asks not to happen.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_USB_VIDEO_CLASS=y
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MON is not set
# CONFIG_SND_USB_AUDIO is not set
# CONFIG_BT_HCIBTUSB is not set

# --- Camera: V4L2 (#6) ---------------------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set

# --- Nothing else needs to be here ---------------------------------------------------------------
# No sound, no virtualisation guest drivers beyond what firmware needs, no tracing, no debugfs.
# CONFIG_SOUND is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_RTC_CLASS is not set
