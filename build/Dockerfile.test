# The test tier — the only one, since #35 retired the host-Python tier.
#
# `docs/test-harness.md`: an `alpine:3.24` container installing **the exact apk versions the ISO
# installs**, so a version skew in `zxing-cpp`, `cryptography` or `libsecp256k1` fails here rather
# than on the appliance.
#
#     docker build -f build/Dockerfile.test -t aobs-test .     # only when the pins change
#     docker run --rm -v "$PWD:/src" -w /src aobs-test         # the dev loop, ~7 m 30 s
#
# The bind mount is what makes this a dev loop rather than a CI job: the image carries the pinned
# userland, the working tree comes from the host, and no rebuild is needed to run an edit. CI runs
# `docker run --rm aobs-test` with no mount, so what it judges is the copy baked in below.
#
# The pins below are apk packages, not PyPI wheels: what the appliance runs is what Alpine ships,
# and installing from PyPI here would test a different set of libraries than the ISO carries.
FROM alpine:3.24

# The exact versions are pinned by `build/apk-versions.txt`, which the ISO build reads too — one
# list, so the two cannot drift apart silently. `=~` would defeat the purpose.
COPY build/apk-versions.txt /tmp/apk-versions.txt
RUN apk add --no-cache $(grep -v '^#' /tmp/apk-versions.txt | grep -v '^$' | tr '\n' ' ')

# `embit` is no longer taken from PyPI: it is vendored in the app tree, pinned by git SHA, so the
# prebuilt blob that exists only in the wheel never reaches this container either (#34).
# `urtypes` is test-only: an independent decoder for our own CBOR.
RUN pip install --break-system-packages --no-cache-dir urtypes==1.0.1

# Which secp256k1 signs is settled by #34 and specified in `docs/boot-pipeline.md`: Alpine's
# packaged `libsecp256k1`, pinned in `build/apk-versions.txt` above like every other input, and
# installed by the same `apk add` line. Nothing is deleted here any more — the vendored `embit`
# never contained the glibc-linked prebuilt in the first place, because that blob is produced at
# wheel-build time and exists in no commit of embit's repository.
#
# This env var is what tells `tests/test_structure.py` it may assert the *backend identity*. That
# claim is about the appliance, so it is checked where the appliance's environment is reproduced;
# on a dev host it would only have been testing whether a wheel shipped a blob for that platform.
# The signature-vector check needs no gate and runs in both tiers.
ENV AOBS_AUTHORITATIVE_TIER=1

WORKDIR /src
COPY . /src

# The package is put on the path rather than installed: what runs here is the tree as committed.
ENV PYTHONPATH=/src
CMD ["python3", "-m", "pytest", "-q"]
