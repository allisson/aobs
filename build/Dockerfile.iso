# The ISO build tier. Separate from `build/Dockerfile.test` on purpose: the dev loop must never
# need a kernel toolchain, and building an image must never need a test runner.
#
#     docker run --rm --platform=linux/amd64 -v "$PWD:/src" -w /src \
#         alpine:3.24 sh build/fetch-inputs.sh          # once, or when a pin changes
#     docker build -f build/Dockerfile.iso -t aobs-iso .
#     mkdir -p out && docker run --rm --privileged -v "$PWD:/src" -v "$PWD/out:/out" aobs-iso
#
# `--privileged` is for one thing: `chroot /rootfs /usr/bin/python3` in stage 1, which runs the
# in-rootfs signature assertions inside the userland the image will actually carry. Nothing else in
# the build needs it.
#
# `docs/boot-pipeline.md`: building the ISO needs a container runtime on the host and nothing else.
#
# `--platform=linux/amd64` is not optional and not a portability nicety. The artifact is
# `bitcoin-signer-amd64.iso`; `syslinux` exists for no other architecture in Alpine, and an
# aarch64 builder would silently install an aarch64 userland into a rootfs meant for an x86_64
# kernel. On an Apple-silicon or other arm64 host this runs under emulation — correct, and slow
# enough that the kernel stage is measured in hours rather than minutes. That the ISO is
# nevertheless byte-identical between an arm64 and an x86_64 builder is claim 1 of
# `docs/reproducible-build.md`, and it is why the maintainer's arm64 build and CI's x86_64 witness
# can be compared at all.
#
# **`FROM scratch` plus a minirootfs tarball, not `FROM alpine:3.24`.** #55 could not establish Docker
# Hub's retention for untagged digests, and a Hub digest is checkable only by pulling from that
# registry; Alpine keeps every point release's minirootfs forever, with a `.sha256` and an `.asc`
# beside it. This closes the last unpinned input in a repository that pins its GitHub Actions by
# commit SHA — without acquiring a registry dependency in exchange. The tarball itself is pinned a
# second time by `build/inputs.sha256`, which is the list the build enforces.
FROM --platform=linux/amd64 scratch
ADD build/inputs/alpine-minirootfs-3.24.1-x86_64.tar.gz /

# The toolchain, pinned by exact version in `build/toolchain-versions.txt` — one file, read here and
# by `build/fetch-inputs.sh`, so the archive and the builder cannot resolve different closures.
#
# The pins are deliberately **not** in `build/apk-versions.txt`. That file's contract is "what goes
# into the image, read by both tiers": `Dockerfile.test` installs every line of it with
# `grep -v '^#'` on purpose, and a compiler in that list would land in the test tier, which needs
# none of it. Nothing installed here reaches `/rootfs`, and `build/verify.py`'s rootfs check proves
# it rather than promising it.
#
# **Installed from `build/inputs/`, over no network at all.** The toolchain closure is archived for
# the reason #57 gives: it dies first and larger, and a toolchain failure kills the build image
# before stage 1 ever runs. The `--mount=type=bind` is what keeps 300 MB of `.apk` files out of the
# resulting image — they are inputs to one `RUN`, not part of the builder.
COPY build/toolchain-versions.txt /tmp/toolchain-versions.txt
RUN --mount=type=bind,source=build/inputs/apks,target=/inputs/apks \
	printf '%s\n' /inputs/apks/main /inputs/apks/community >/etc/apk/repositories && \
	apk add --no-cache \
		$(sed -n 's/^\([a-z0-9][^ #]*\)$/\1/p' /tmp/toolchain-versions.txt | tr '\n' ' ') && \
	rm -f /tmp/toolchain-versions.txt

# What a deterministic build needs from its environment, fixed here **and again in `mkiso.sh`**. Not
# belt-and-braces duplication: the reproducibility guard runs the second build with `-e TZ=...`,
# `-e LC_ALL=...` and a different umask precisely to prove the build ignores them, and a `docker run
# -e` overrides an `ENV`. So these are the defaults, and `mkiso.sh` is the enforcement.
#
# `KBUILD_BUILD_USER`, `KBUILD_BUILD_HOST` and `KBUILD_BUILD_TIMESTAMP` are the three Kbuild reads
# from the machine; without them the builder's user, hostname and clock end up inside `bzImage`.
#
# The timestamp is a **parseable date and not a label**. `usr/Makefile` hands it to
# `gen_initramfs.sh` as `-d "$KBUILD_BUILD_TIMESTAMP"`, which runs `date -d"$1" +%s || :` and, given
# a string that is not a date, silently falls back to the wall clock for the built-in initramfs's
# mtimes. `mkiso.sh` replaces this default with the `SOURCE_DATE_EPOCH` date; the constant here only
# has to keep a bare `docker run` of this image out of the same trap.
ENV LC_ALL=C
ENV LANG=C
ENV TZ=UTC
ENV KBUILD_BUILD_TIMESTAMP="1970-01-01 00:00:00 UTC"
ENV KBUILD_BUILD_USER=aobs
ENV KBUILD_BUILD_HOST=aobs

WORKDIR /src
CMD ["/bin/sh", "/src/build/mkiso.sh"]
