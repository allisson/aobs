__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/

# NOT `build/`. That directory is source — PID 1, the pinned package list, the
# build-time assertions — and the Python-packaging default would silently untrack it.

# The image build writes here.
out/
build/inputs/

# The source fetch writes here.
build/sources/

# docs/release.md stages the published assets here. Ignored because the release-mode
# refusals judge `git status --porcelain`, and an untracked `release/` would make the
# manifest step refuse itself.
release/
