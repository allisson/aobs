#!/bin/sh
# The wrapper 01-boot-layer.md §9 calls for, and the last line of the diagnostic path.
#
# /usr/bin/aobs reports its own startup failures: it knows the typed error variant, which
# is what §9 asks to be printed, and it halts with the block visible rather than exiting.
# So reaching the end of this script means the binary never got far enough to speak for
# itself — a missing shared library, a wrong interpreter, an image built wrong. That is
# precisely the case a wrapper exists to cover, and it is the failure a mis-built image
# produces.
#
# Fixed strings only. No exit status, no linker message, no program state (§9).

/usr/bin/aobs
status=$?

# **The status the app exits with has to become this script's status**, or §2's exit-status
# contract is inert: `exit 42` would never reach systemd, so `SuccessExitStatus=42` and
# `SuccessAction=poweroff` would never fire and *end the session* would print the block
# below instead of powering the machine off. The same swallowing turned a crash — §2's stated
# product fact, restart and a blank signer — into a permanent park on the wrong code.
#
# 126 and 127 are the discriminator, and they are the shell's own rather than anything the
# app can produce: 127 is *command not found*, which is also what the dynamic loader exits
# with on a missing shared library, and 126 is *found and not executable*, which is the wrong
# interpreter. That is exactly the list above. The app exits only 42 or 0, or parks forever
# on §9's diagnostic, so nothing collides.
if [ "${status}" -ne 126 ] && [ "${status}" -ne 127 ]; then
    exit "${status}"
fi

cat <<'EOF'

========================================================================
aobs could not start.

  The signer program stopped before it could report anything itself.
  This image is built wrong, or the medium it was written to is damaged.
  Verify the download against its signature and write the medium again.

  failure code AOBS-E00
========================================================================
This machine has halted. Power it off when you have read this.
EOF

# Halt with the text visible; do not power off (§9). Exiting would let the unit's
# Restart=always scroll the only explanation the user is going to get off the screen.
while true; do
    sleep 3600
done
