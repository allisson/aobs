#!/bin/sh
# The unprivileged kiosk user, and the one service that is the appliance.
# 01-boot-layer.md §2.
set -eu

# `signer` gets no shell: nothing on this image is meant to be driven from one.
adduser --system --group --disabled-login \
    --home /var/lib/aobs --shell /usr/sbin/nologin \
    signer

# video for DRM master, input for libinput (§2), read from systemd's own udev rules rather
# than from convention: /dev/fb0 is SUBSYSTEM=="graphics" → root:video, /dev/dri/card0 →
# root:video, /dev/video0 → root:video, /dev/input/event* → root:input.
#
# The third is `dialout`, for the serial mirror (§2, §9), and it is granted by the unit's
# SupplementaryGroups= rather than here: systemd sets the credentials directly, so a group
# named there needs no membership in /etc/group. Named here anyway, because "no third
# group" is what this comment used to say and the unit next to it says otherwise.
#
# The seat group this hook used to read out of seatd.service is gone with ADR-0016. There
# is no seatd, no libseat1, and `backend-linuxkms-noseat` opens /dev/fb0 with a plain
# open(2) — so there is no socket to own and nothing left to guard.
adduser signer video
adduser signer input

systemctl enable aobs.service

# greetd is rejected (§2): its initial_session runs exactly once per boot by design,
# which is the opposite of what a restarting kiosk needs. systemd's Restart=always is.
