#!/bin/sh
# The boot menu. 01-boot-layer.md §7: exactly two entries, so insufficient RAM degrades
# instead of bricking.
#
#   1. toram — the default. It earns its RAM for two product reasons: the user can pull
#      the stick once booted, and yanking it cannot kill a session mid-signature.
#   2. "low memory: keep the USB inserted" — the same command line without toram.
#
# live-build's generated menu is replaced wholesale rather than appended to, because the
# menu is part of the product: a third entry nobody decided on is a third way to boot.
#
# Binary hooks run with the working directory inside binary/.
set -eu

. ../cmdline.sh

kernel="$(ls live/vmlinuz-* | sort -V | tail -n 1 | xargs basename)"
version="${kernel#vmlinuz-}"
initrd="initrd.img-${version}"

if [ ! -f "live/${initrd}" ]; then
    echo "9000-aobs-grub-menu: live/${initrd} is missing beside live/${kernel}." >&2
    exit 1
fi

cat > boot/grub/grub.cfg <<EOF
# Generated by config/hooks/normal/9000-aobs-grub-menu.hook.binary.
# The command line is 01-boot-layer.md §6, held in image/cmdline.sh.

set default=0
set timeout=5

menuentry "aobs — amnesic offline Bitcoin signer" {
	linux	/live/${kernel} ${AOBS_CMDLINE_TORAM}
	initrd	/live/${initrd}
}

menuentry "aobs — low memory: keep the USB inserted" {
	linux	/live/${kernel} ${AOBS_CMDLINE}
	initrd	/live/${initrd}
}
EOF

# live-build normalises mtimes from SOURCE_DATE_EPOCH; a file we wrote ourselves has to
# join in or it is the one thing in the image that differs between two builds.
touch -d "@${SOURCE_DATE_EPOCH}" boot/grub/grub.cfg

echo "9000-aobs-grub-menu: two entries against /live/${kernel}"
